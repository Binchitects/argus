# ==============================================================================
# TITLE: Qwen3.8-Flash-Next (177B MoE, 10 of 512 experts active) on one RTX 5090
# HARDWARE: RTX 5090 32 GB, 64 GB+ RAM (measured with 123 GB, which keeps the whole model in memory), 16+ CPU cores, NVMe
# DOWNLOAD: First start downloads 94.1 GB: the UD-IQ4_XS model in three parts
# MEASURED: 26.9 tok/s for one person, 16.1 tok/s each for two; a 28,500-token prompt read in 48 s, a repeated 14,000-token one in 0.2 s; 256K context in 31.0 of 32.6 GB VRAM. NVFP4 (axiomofmind W4A16, 180 GB) was slower on the same machine: 23.9 / 13.9 tok/s and 90 s for that prompt
# STATUS: Measured on this hardware (i7-14700K, 123 GB RAM, RTX 5090, driver 595). -ub 2048 reads prompts 55% faster than -ub 1024 for about 5% slower decode (28.2 / 16.6 tok/s with N_CPU_MOE 36 and -ub 1024).
# ==============================================================================
#
# This file is the whole deployment. There is no setup script.
#
#   1. cp env-samples/qwen3.8-flash-next.rtx5090.env .env
#   2. Make the secrets. Every empty value under SECRETS says how to make it;
#      this one command fills all of them at once (run it in stack/):
#        awk '/^# SECRETS/{s=1} /^# PEOPLE/{s=0} s && /^[A-Z0-9_]+=$/{c="openssl rand -hex 24"; c|getline r; close(c); if ($0 ~ /^LITELLM_/) r="sk-" r; $0=$0 r} {print}' .env > .env.new && mv .env.new .env && chmod 600 .env
#   3. Point LLAMACPP_MODEL_DIR at a directory on NVMe with room for the download.
#   4. docker compose up -d
#
# No secret is ever shipped in this file: a sample in a public repository would give
# every deployment the same passwords.
#
# Then open https://<LLM_DOMAIN> and sign in as admin with ADMIN_PASSWORD.
# The browser warns once about the self-signed certificate; accept it.
# First start of a new model downloads it: docker logs -f model-init

# ------------------------------------------------------------------------------
# STACK
# ------------------------------------------------------------------------------
# Which parts run. Add argus for the code index, image for pictures, tracing for Langfuse.
# `logging` (Loki + Promtail) is on by default: every service's output is
# collected, searchable on the app's Logs page, and an index run leaves a
# history behind instead of only an exit code. Remove it from this list to turn
# collection off -- nothing else depends on it, and the Logs page says so.
COMPOSE_PROFILES=gateway,proxy,auth,smi,llamacpp,logging
COMPOSE_PROJECT_NAME=llmservice
# Every service is https://<name>.<LLM_DOMAIN>. Change it here only; certificates and SSO follow.
LLM_DOMAIN=llm.localhost
# 127.0.0.1 = this machine only. 0.0.0.0 = the network.
BIND_ADDRESS=127.0.0.1
# The first admin's email (the app's `admin` account and Open WebUI's administrator).
ADMIN_EMAIL=admin@example.com
# The owner of stack/config (`id -u` and `id -g`). The app runs as this user,
# so the files it writes stay yours.
LLM_UID=1000
LLM_GID=1000
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Where each directory lives -- relative to this compose file, or absolute.
# Every bind mount uses these, so a deployment can be laid out however the host
# requires: config on one disk, models on another, samples elsewhere.
LLM_CONFIG_DIR=./config
LLM_DEPLOY_DIR=./deploy
LLM_MODELS_DIR=./models
LLM_ENV_SAMPLES_DIR=./env-samples
# Host paths the monitoring containers read. Change these for a rootless daemon
# or a Docker root that is not /var/lib/docker.
DOCKER_SOCKET=/var/run/docker.sock
HOST_DOCKER_DIR=/var/lib/docker
HOST_ROOT=/
HOST_PROC=/proc
HOST_SYS=/sys
HOST_DEV_DISK=/dev/disk


# ------------------------------------------------------------------------------
# MODEL
# ------------------------------------------------------------------------------
# >>> MODEL -- the admin panel's Model card swaps exactly this block.
# The one name every client sees (gateway, Open WebUI, Qwen Code). Nothing else is listed.
MODEL_NAME=Qwen3.8-Flash-Next
# Context window in tokens, shared by all slots (see --kv-unified).
MODEL_CONTEXT=262144
# Largest completion the gateway advertises.
MODEL_MAX_OUTPUT=32768
# How hard the model thinks before answering when a chat or client does not say:
# xhigh (the model's own default, and slowest), medium, or low. Medium answers
# most questions well in far less time; a chat can still pick Deep think.
# Read by the ENGINE's chat template.
MODEL_REASONING_EFFORT=medium
# false turns thinking off entirely, so the model answers immediately.
MODEL_ENABLE_THINKING=true

# Thinking level, chosen per chat from the Open WebUI model picker. One model
# preset is created per entry, formatted level:Label. `off` disables thinking
# entirely (enable_thinking=false); the rest are the engine's reasoning_effort
# values -- xhigh (the model's own default), medium, low. Empty turns the
# presets off and leaves only the deployment-wide MODEL_REASONING_EFFORT.
#
# These exist because the reasoning_effort field Open WebUI's own params panel
# offers does NOT work here: it goes out as a top-level field and LiteLLM drops
# that for a custom openai/ api_base. Measured: identical reasoning with and
# without it. custom_params does reach the engine. See stack/deploy/seed-presets.py
THINKING_PRESETS=xhigh:Deep think,medium:Balanced,low:Quick,off:No thinking
# Host directory for the GGUF files. PUT IT ON NVMe: the weights are paged in on demand.
LLAMACPP_MODEL_DIR=/opt/models/Qwen3.8-Flash-Next
# The folder Admin -> Models adds more models from (it holds the model directory
# above and any others). Empty: the model directory alone.
LLAMACPP_LIBRARY_DIR=/opt/models
# How many models stay loaded at once; one GPU usually holds one large model.
LLAMACPP_MODELS_MAX=1
# Hugging Face repo to download from on first start. Empty = the files must already be in LLAMACPP_MODEL_DIR.
LLAMACPP_HF_REPO=unsloth/Qwen3.8-Flash-Next-GGUF
# Space-separated paths inside that repo. They land flat in LLAMACPP_MODEL_DIR and are SHA-256 checked.
LLAMACPP_HF_FILES=UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf
# File name of the model (for a split GGUF, the first shard).
LLAMACPP_MODEL_FILE=Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf
# A llama.cpp release tarball to run instead of the stock server. Empty = stock image.
LLAMACPP_ENGINE_URL=
# Checksum of that tarball.
LLAMACPP_ENGINE_SHA256=
# Multi-token prediction: tokens drafted per step. 0 = off.
LLAMACPP_MTP_DRAFT_MAX=0
# Separate MTP draft head file in LLAMACPP_MODEL_DIR. Empty = the model's own MTP layer.
LLAMACPP_MTP_HEAD=
# Extra flags for the draft.
LLAMACPP_MTP_ARGS=
# Layers on the GPU. 99 = all.
LLAMACPP_N_GPU_LAYERS=99
# MoE only: layers whose experts stay in system RAM. Raise if loading hits CUDA out of memory. 0 for dense models.
LLAMACPP_N_CPU_MOE=37
# KV cache precision. q8_0 halves it against f16 for little quality cost.
LLAMACPP_KV_TYPE=q8_0
# People served at the same time. More queue.
LLAMACPP_PARALLEL=2
# Anything else for llama-server.
LLAMACPP_EXTRA_ARGS=--flash-attn on -b 2048 -ub 2048 --cache-reuse 256 -ot per_layer_token_embd=CPU --kv-unified
# The gateway's backend (http://vllm:8000/v1 for vLLM).
ENGINE_API_BASE=http://llamacpp:8080/v1
# <<< MODEL


# ------------------------------------------------------------------------------
# IMAGE GENERATION -- add `image` to COMPOSE_PROFILES to run it
# ------------------------------------------------------------------------------
# A picture model beside the chat model, on the same GPU: the chat's image tool
# and API keys use it through the gateway. FLUX.2 [klein] 4B (Apache 2.0) takes
# about 5 GB of files (listed at the imagegen service in docker-compose.yml)
# and keeps them in RAM; on a 24 GB card beside a 21 GB chat model, a
# 1024x1024 picture takes about 30 s.
IMAGEGEN_MODEL_NAME=FLUX.2-klein-4B
# The host folder with the three files.
IMAGEGEN_MODEL_DIR=
IMAGEGEN_DIFFUSION_MODEL=flux-2-klein-4b-Q4_0.gguf
IMAGEGEN_TEXT_ENCODER=Qwen3-4B-Q4_K_M.gguf
IMAGEGEN_VAE=flux2-vae.safetensors
IMAGEGEN_STEPS=4
IMAGEGEN_CFG_SCALE=1.0
# GiB of GPU memory it may use; negative leaves that much free for the chat model.
IMAGEGEN_MAX_VRAM=-1

# ------------------------------------------------------------------------------
# PYTHON SANDBOX -- add `sandbox` to COMPOSE_PROFILES to run it
# ------------------------------------------------------------------------------
# The chat's Python tool: data analysis, charts, files. No network at all; each
# run is its own unprivileged user with CPU, memory, file and process limits.
# The image is built on first `up` (numpy, pandas, matplotlib, scipy, sympy,
# openpyxl: about 100 MB from PyPI). Run scripts/sandbox-check.py to test it.
SANDBOX_SLOTS=2
SANDBOX_JOB_MEMORY_MB=1536
SANDBOX_MEMORY=3g
SANDBOX_CPUS=2

# ------------------------------------------------------------------------------
# WEB SEARCH -- add `websearch` to COMPOSE_PROFILES to run it
# ------------------------------------------------------------------------------
# SearXNG, for the chat's Web tool (which stays off until an admin turns it on
# and allows sites, in Settings -> Python and web). Leave both off air-gapped.
# Its key: generate one with   openssl rand -hex 32
SEARXNG_SECRET=

# ------------------------------------------------------------------------------
# HARDWARE -- this machine, not the model
# ------------------------------------------------------------------------------
# Physical core count. Hyperthreads measured slower, not faster. i7-14700K: 20 (8 P + 12 E).
LLAMACPP_THREADS=20
# CPU ceiling for the engine container; keep it equal to LLAMACPP_THREADS.
LLAMACPP_CPUS=20
OLLAMA_CPUS=2
POSTGRES_CPUS=3
# Engine RAM ceiling, e.g. 56g. 0 = no limit.
LLAMACPP_MEM_LIMIT=0
# GPU power cap in watts (nvidia-smi -pl). Empty = driver default.
GPU_POWER_LIMIT_W=
# CPU package power cap in watts (Intel RAPL). Many boards ship with no limit and cook the CPU. Empty = firmware setting: this 14700K board ships 253 W, and under two people on Qwen3.8-Flash-Next the package peaked at 80 C, so no cap is set.
CPU_POWER_LIMIT_W=

# ------------------------------------------------------------------------------
# MEMORY -- keeping the weights in RAM
# ------------------------------------------------------------------------------
# Flash-Next maps ~87 GB of weights and keeps most experts in system RAM. With
# 96 GB+ of RAM `auto` pins them (--mlock) and nothing is ever read from disk
# again; with 64 GB it cannot, so the weights page in from NVMe: heavy on a cold
# start, fading to ~6 MB/s within ~20 minutes as the page cache settles (measured
# on a 61 GB machine, speed unaffected). `free` shows that cache under
# buff/cache, not under used -- the model IS using the RAM.
# auto = pin (--mlock) when the weights live in system RAM and fit beside the
# reserve; on / off force it. Pinning more than you have makes the host thrash.
LLAMACPP_MLOCK=auto
# auto = read a model that fits in RAM into the page cache before serving, at
# full sequential disk speed, instead of paging it in during the first requests.
LLAMACPP_PRELOAD=auto
# RAM left for everything else when deciding whether the weights fit.
LLAMACPP_RAM_RESERVE_GB=8
# Host vm.swappiness. Empty = leave the system default. Measured on Flash-Next
# at 64 GB: 60 and 150 performed the same; paging fades as the cache warms.
HOST_SWAPPINESS=

# ------------------------------------------------------------------------------
# PRICING -- per 1M tokens, the currency your credit is in (USD by default)
# ------------------------------------------------------------------------------
# Prompt tokens the engine had to process (cache miss).
PRICE_INPUT_PER_MTOK=0.20
# Prompt tokens served from the engine's prefix cache (cache hit): a resent
# conversation or system prompt. Priced separately, DeepSeek-style.
PRICE_CACHED_INPUT_PER_MTOK=0.02
# Generated tokens, reasoning included.
PRICE_OUTPUT_PER_MTOK=0.80


# ------------------------------------------------------------------------------
# SECRETS -- every one must be set; docker compose names any that is missing
# ------------------------------------------------------------------------------
# The first admin's password, used on the very first start only; change it in the app
# afterwards. A few unrelated words, or: openssl rand -hex 24
ADMIN_PASSWORD=
# openssl rand -hex 32
PROXY_AUTH_PASSWORD=
PROXY_AUTH_USER=admin
# The engine's own key. openssl rand -hex 32
LLAMACPP_API_KEY=
# Must start with sk-:  echo sk-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=
# Must start with sk-:  echo sk-$(openssl rand -hex 24). Never change it after first start.
LITELLM_SALT_KEY=
# openssl rand -hex 32
LLM_PG_PASSWORD=
# openssl rand -hex 32
WEBUI_SECRET_KEY=
# Encrypts the app's sign-in keys in the database. openssl rand -hex 32. Never change it after first start.
APP_DATA_KEY=
# openssl rand -hex 32
OPENWEBUI_OIDC_CLIENT_SECRET=
# openssl rand -hex 32
API_OIDC_CLIENT_SECRET=
# Only with the argus profile. openssl rand -hex 32
ARGUS_ADMIN_TOKEN=
# Only with the argus profile: lets Open WebUI use Argus per person. openssl rand -hex 32
ARGUS_CHAT_CLIENT_TOKEN=


# ------------------------------------------------------------------------------
# PEOPLE, GATEWAY AND DASHBOARDS
# ------------------------------------------------------------------------------
# Default monthly credit per person, in USD.
LITELLM_DEFAULT_USER_BUDGET=50
LITELLM_BUDGET_DURATION=1mo
LITELLM_WORKERS=1
WEBUI_DEFAULT_ROLE=user
PROTECTED_CHAIN=sso-chain@file
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
# Only for gated Hugging Face repos.
HF_TOKEN=

# ------------------------------------------------------------------------------
# COMPANY DIRECTORY (LDAP / Active Directory) -- optional, off while LDAP_URL is empty
# ------------------------------------------------------------------------------
# People then sign in with their directory account; the app creates them on
# first sign-in, gives them an API key, and checks every LDAP_SYNC_INTERVAL
# that they are still there (people who leave are disabled, keys blocked).
# Local accounts keep working next to it.
#   OpenLDAP:          LDAP_URL=ldaps://ldap.example.com   (or ldap://... with LDAP_STARTTLS=true)
#   Active Directory:  LDAP_URL=ldaps://dc1.example.com:636
LDAP_URL=
LDAP_STARTTLS=false
# A read-only service account that can search people and groups. Never an admin.
#   AD:       CN=svc-llm,OU=Service Accounts,DC=example,DC=com
#   OpenLDAP: cn=svc-llm,ou=system,dc=example,dc=com
LDAP_BIND_DN=
# That account's password. Comes from your directory team; nothing here can make it.
LDAP_BIND_PASSWORD=
# Where people are (searched below this).  AD: OU=Staff,DC=example,DC=com
LDAP_USER_BASE_DN=
# Where groups are, for directories without memberOf (OpenLDAP without the overlay).
# Leave empty on Active Directory.
LDAP_GROUP_BASE_DN=
# Members of this group are admins here (a group name or its full DN).
LDAP_ADMIN_GROUP=
# Only members of this group may sign in. Empty = everyone the search finds.
LDAP_REQUIRED_GROUP=
# How often the directory is checked for people who left (hh:mm:ss).
LDAP_SYNC_INTERVAL=00:15:00
# Testing only: accept any certificate from the directory server.
LDAP_INSECURE_SKIP_VERIFY=false


# ------------------------------------------------------------------------------
# ARGUS (profile: argus) -- code index for agents
# ------------------------------------------------------------------------------
ARGUS_VERSION=latest
ARGUS_GITLAB_URL=
# READ-ONLY GitLab token (read_api, read_repository) for an account that is at least Reporter in every project to index. No admin or sudo needed: per-person access is read from project members.
ARGUS_GITLAB_TOKEN=
# ONLY if no token can be issued for the account: a way in with a username and
# password. Argus signs in through GitLab's web form and mints a personal access
# token from the session, so the password reaches exactly one request and is
# never used for clones.
# ARGUS_GITLAB_AUTH is inferred when empty, and a username WINS over a token --
# so set it to `token` explicitly if a username is left here from an earlier
# experiment and the token is the credential you mean to use.
# Prefer ARGUS_GITLAB_TOKEN wherever a token is possible: a password is reusable
# everywhere that account signs in, and anything that reads this container's
# environment (`docker inspect`) reads it too.
ARGUS_GITLAB_AUTH=
ARGUS_GITLAB_USERNAME=
ARGUS_GITLAB_PASSWORD=
# For a GitLab on a private CA: drop the PEM in config/argus/tls/ and point this at the
# path INSIDE the container, e.g. /etc/argus/tls/gitlab-ca.pem. Applies to the API and to
# every clone: Argus reaches GitLab over two transports that cannot see each other's TLS
# configuration, so setting only one looks like a bad token.
ARGUS_GITLAB_CA_CERT=
# Last resort for a self-signed GitLab with NO CA file available: set to false. Disables
# certificate verification for every API call and clone to that GitLab. Setting this AND
# ARGUS_GITLAB_CA_CERT is refused at startup rather than silently resolved.
ARGUS_GITLAB_VERIFY=


# ------------------------------------------------------------------------------
# BACKUP -- ./scripts/backup.sh does it all; sudo ./scripts/backup.sh --install-timer runs it daily
# ------------------------------------------------------------------------------
# Where backups go. Put it on a different disk from the data it protects.
BACKUP_DIR=./backups
# A second, verified copy of every good backup, on ANOTHER physical disk; empty = none.
# Without it, one failed disk takes the data and all of its backups together.
BACKUP_COPY_DIR=
# How many backups to keep; older ones are removed after a good backup.
BACKUP_KEEP=14
# 1 = also Loki logs and Prometheus metrics.
BACKUP_INCLUDE_LOGS=1
# When the timer runs it (HH:MM, or any systemd OnCalendar value).
BACKUP_TIME=03:30
