    {
      "type": "timeseries",
      "title": "NVMe temperature over time",
      "description": "NVMe composite temperature (SMART temp1) from node-exporter's hwmon collector, which reads the kernel's own nvme sensors -- node-exporter already mounts the host /sys, so no extra exporter is needed. Series are the two drives, named by the query from the hwmon chip (nvme_nvme0 = WD_BLACK SN850X, nvme_nvme1 = Samsung 990 PRO); update those names if the drives change. The 990 PRO also reports Sensor 1 and Sensor 2 (NAND and controller) as temp2/temp3, which the drive's Composite lags under sustained writes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 55
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(label_replace(node_hwmon_temp_celsius{chip=~\"nvme_nvme[0-9]+\",sensor=\"temp1\"},\"drive\",\"$1\",\"chip\",\"^nvme_(nvme[0-9]+)$\"),\"drive\",\"Samsung SSD 990 PRO 2TB\",\"chip\",\"^nvme_nvme1$\"),\"drive\",\"WD_BLACK SN850X 1TB\",\"chip\",\"^nvme_nvme0$\")",
          "legendFormat": "{{drive}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
