            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "idle"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Active requests",
      "description": "Requests being processed now, across all slots. The engine runs LLAMACPP_PARALLEL slots; beyond that, requests queue.",
