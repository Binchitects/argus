        },
        {
          "type": "gauge",
          "title": "KV cache used",
          "description": "Fraction of the engine's KV cache in use. vLLM exports vllm:gpu_cache_usage_perc; llama.cpp builds that still export llamacpp:kv_cache_usage_ratio show here too. Newer llama.cpp builds dropped that metric, so this reads 'no data' on them -- context pressure then shows up as rising 'Requests queued' instead.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 49,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "max(vllm:gpu_cache_usage_perc) or max(llamacpp:kv_cache_usage_ratio)",
              "legendFormat": "kv cache"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "yellow",
                    "value": 0.85
                  },
                  {
                    "color": "red",
                    "value": 0.95
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            }
          }
        },
        {
          "type": "stat",
          "title": "Output tokens/sec (5 min avg)",
          "description": "Tokens delivered per second across all users, averaged over 5 minutes. On llama.cpp tokens are counted when a request finishes, so this lags a long answer; Stack Performance has the live rate.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 49,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(vllm:generation_tokens_total[5m])) or sum(rate(llamacpp:tokens_predicted_total[5m]))",
              "legendFormat": "tok/s"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 1,
              "color": {
                "mode": "fixed",
                "fixedColor": "blue"
              }
            },
            "overrides": []
          },
          "options": {
            "graphMode": "area",
            "colorMode": "value",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            }
          }
        },
        {
          "type": "timeseries",
          "title": "Engine time to first token (vLLM) / prompt processing speed (llama.cpp)",
          "description": "vLLM exports a TTFT histogram; llama.cpp does not, so for llama.cpp this shows prompt-processing speed (tokens/s while prefilling), which is what TTFT is made of. Request-level TTFT for every engine is in 'Time to first token' above, from LiteLLM's logs.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 56,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
              "legendFormat": "vLLM p50 TTFT (s)"
            },
            {
              "refId": "B",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
              "legendFormat": "vLLM p95 TTFT (s)"
            },
            {
              "refId": "C",
              "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
              "legendFormat": "vLLM p99 TTFT (s)"
            },
            {
              "refId": "D",
              "expr": "sum(rate(llamacpp:prompt_tokens_total[5m])) / sum(rate(llamacpp:prompt_seconds_total[5m])) >= 0",
              "legendFormat": "llama.cpp prefill tok/s"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 8,
                "showPoints": "never"
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "llama.cpp prefill tok/s"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "short"
                  },
                  {
                    "id": "custom.axisPlacement",
                    "value": "right"
                  }
                ]
              }
            ]
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        },
        {
          "type": "timeseries",
          "title": "Scheduler: running vs waiting",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 56,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(vllm:num_requests_running) or sum(llamacpp:requests_processing)",
              "legendFormat": "running"
            },
            {
              "refId": "B",
              "expr": "sum(vllm:num_requests_waiting) or sum(llamacpp:requests_deferred)",
              "legendFormat": "waiting"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "custom": {
                "drawStyle": "line",
                "lineWidth": 2,
                "fillOpacity": 25,
                "stacking": {
                  "mode": "normal"
                },
                "showPoints": "never"
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true
            }
          }
        }
      ]
    }
  ]
}
