          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status IS NOT NULL AND status <> 'success') AS \"Failures\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")"
