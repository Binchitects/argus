      "type": "timeseries",
      "title": "VRAM used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Weights plus KV cache. A window that spills to system RAM shows here as a total that stops growing while generation slows.",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
