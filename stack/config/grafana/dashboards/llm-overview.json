{
  "uid": "llm-overview",
  "title": "LLM Overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "1m",
  "tags": [
    "llmservice",
    "inference",
    "gateway"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
