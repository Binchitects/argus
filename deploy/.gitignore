# Secrets — never commit. Copy a file from env-samples/ as the template.
.env
.env.*

# Local model weights (large, re-downloadable)
models/*
!models/.gitkeep

# Volume backups contain .env and database dumps
backups/

# Agent/session scratch and local tool state - not part of the stack
.remember/
.claude/
.cache/
.deploytest/

# Runtime logs written into config dirs by the services themselves

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
.idea/
.vscode/

# The exported TLS certificate (tls-init)
config/traefik/certs/*
!config/traefik/certs/.gitkeep

# Argus's private CA for a GitLab that is not on a public one. Whatever an
# operator drops here belongs to their environment, not to this repository --
# and unlike the self-signed certificate above, it is not reproducible from
# .env. The README stays so the directory exists in a fresh clone and the bind
# mount in docker-compose.yml never has to be created by Docker.
config/argus/tls/*
!config/argus/tls/README.md

# Issued API keys - never commit
.keys/

# packaging scratch and built release artefacts (hundreds of MB, and
# rebuildable with scripts/package.sh)
.pkgstage/
dist/

# redeploy-test.sh artefacts
.redeploy-setup*.log
redeploy-report.txt

# Prometheus needs a bearer token to scrape llama.cpp, which protects every
# path except /health. Written by the prometheus-secrets service from LLAMACPP_API_KEY.
config/prometheus/secrets/*
!config/prometheus/secrets/.gitkeep

# The hash-free account list the app writes for Argus to read.
#
# The DIRECTORY is kept in the repository with a placeholder, and only its
# CONTENTS are ignored. Without that, a fresh clone has no source for the argus
# and app bind mounts, so Docker creates a root-owned empty directory there
# instead -- which is exactly the failure `make preflight` exists to name.
config/directory/*
!config/directory/.gitkeep
config/ca/*.crt
config/ca/*.pem

# The Settings page's pending .env changes (can hold a secret)
config/app/pending.env
config/app/pending.env.tmp
# Written by the app for the engine and Prometheus (Admin -> Models).
config/engine/*
!config/engine/README.md
config/app/applied-*
