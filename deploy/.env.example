# Argus Arena. Copy to .env, fill in the blanks, then: docker compose up -d

# The address people open: https://DOMAIN (also gateway.DOMAIN and argus.DOMAIN).
DOMAIN=llm.localhost
ADMIN_EMAIL=admin@example.com

# Where models live, on a fast disk the app (uid 1000) can write.
MODELS_DIR=./models
# The first chat model, fetched from Hugging Face on the first start (repo:quant).
# More are added under Admin -> Models.
MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL

# Secrets. Make each with: openssl rand -hex 32
ADMIN_PASSWORD=
DB_PASSWORD=
APP_KEY=
ENGINE_KEY=
ARGUS_KEY=
# The gateway's master key must start with sk-: echo sk-$(openssl rand -hex 32)
GATEWAY_KEY=

# Optional
# HF_TOKEN=                      for gated Hugging Face models
# ACME_EMAIL=                    real certificates from Let's Encrypt (a public DOMAIN)
# GITLAB_URL=                    the code index: your GitLab and a read-only token
# GITLAB_TOKEN=                  (read_api and read_repository)
# HTTP_PORT=8080 / HTTPS_PORT=8443  other ports (rootless Podman cannot take 80 and 443)
# GPU_POWER_LIMIT_W=             watts per GPU
# CPU_POWER_LIMIT_W=             CPU package watts (Intel)
