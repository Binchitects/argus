# Argus Arena. Copy to .env, fill in the blanks, then: docker compose up -d

# The address people open: https://DOMAIN (also gateway.DOMAIN and argus.DOMAIN).
DOMAIN=llm.localhost
ADMIN_EMAIL=admin@example.com

# Where models live, on a fast disk the app (uid 1000) can write.
MODELS_DIR=./models
# The first chat model, fetched from Hugging Face on the first start (repo:quant).
# More are added under Admin -> Models.
MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL

# Secrets. Make each with: openssl rand -hex 32
ADMIN_PASSWORD=
DB_PASSWORD=
APP_KEY=
ENGINE_KEY=
ARGUS_KEY=
# The gateway's master key must start with sk-: echo sk-$(openssl rand -hex 32)
GATEWAY_KEY=

# Optional
# HF_TOKEN=                      for gated Hugging Face models
# ACME_EMAIL=                    real certificates from Let's Encrypt (a public DOMAIN)
# GITLAB_URL=                    the code index: your GitLab and a read-only token
# GITLAB_TOKEN=                  (read_api and read_repository)
# GITLAB_USERNAME=               only when no token can be made: Argus signs in once
# GITLAB_PASSWORD=               with these and makes its own token (a username wins over a token)
# GITLAB_VERIFY_TLS=false        testing only: accept any certificate from GitLab
# BACKUP_DIR= BACKUP_COPY_DIR= BACKUP_KEEP=14 BACKUP_INCLUDE_LOGS=1 BACKUP_TIME=03:30
#                                scripts/backup.sh: where backups go, a second copy, how many, when
# HTTP_PORT=8080 / HTTPS_PORT=8443  other ports (rootless Podman cannot take 80 and 443)
# DB_HOST= DB_PORT=5432 DB_USER=arena   an external Postgres (16 or newer) instead of the stack's;
# DB_SSL_MODE=require                    leave postgres out (docs/deployment.md, "External Postgres")
# APP_REPLICAS=2                 with scale.yml: several app replicas behind Traefik
# COMPOSE_PROFILES=laya          Laya, typed decisions on the CPU (the Decide tool, Code Arena's
#                                command check); the app fetches its weights (1.5 GB) into MODELS_DIR/laya
# GPU_POWER_LIMIT_W=             watts per GPU
# CPU_POWER_LIMIT_W=             CPU package watts (Intel)
