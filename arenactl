def cmd_test(a) -> int:
    suites = a.suites or ["app", "code-arena", "code-intel", "web", "deploy"]
    engine = Engine()
    dotnet, base = (["dotnet"], "/") if any(version_of(x) >= (10,) for x in (output(["dotnet", "--list-sdks"]) or "").splitlines()) else ([str(TOOLS / "dn")], "/repo")
    projects = {"app": "tests/Llm.Tests", "code-arena": "tests/CodeArena.Tests", "code-intel": "tests/CodeIntel.Tests"}
    failed = []
    for s in suites:
        step(f"tests: {s}")
        if s in projects:
            if dotnet[0] != "dotnet" and not engine.ok:
                raise Stop(".NET SDK 10, or Docker for its container (tools/dn), is needed for the .NET tests")
            rc = run([*dotnet, "test", projects[s], *(["--filter", a.filter] if a.filter else [])], cwd=ROOT, check=False)
        elif s == "web":
            rc = run(["npm", "test", "--", *([a.filter] if a.filter else [])], cwd=ROOT / "src" / "web", check=False)
        elif s == "deploy":
            rc = run([sys.executable, "-m", "unittest", "discover", "-q", *(["-k", a.filter] if a.filter else [])], cwd=ROOT / "tests" / "deploy", check=False)
        else:
            raise Stop(f"no test suite {s} (app, code-arena, code-intel, web, deploy)", 2)
        if rc:
            failed.append(s)
    say("All passed." if not failed else f"Failed: {', '.join(failed)}")
    return 1 if failed else 0


# ----------------------------------------------------------------------------- every script
def first_line(path: Path) -> str:
    """What a script says it is for: its header comment's first line, or its docstring's."""
    doc = False
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines()[:15]:
        line = line.strip()
        if line.startswith("#!") or line.startswith("from __future__") or not line:
            continue
        if line.startswith('"""'):
            doc = True
            line = line[3:]
        if (doc or line.startswith("#")) and len(line.strip('#" ')) > 3:
            return line.strip('#" ').rstrip(":")
    return ""


DOCKER_PROXY_CONF = Path("/etc/systemd/system/docker.service.d/http-proxy.conf")


def proxy_answers(url: str) -> str | None:
    """None when the proxy reaches Docker Hub's registry (it answers 401 without a token), else what went wrong."""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({"http": url, "https": url}))
    try:
        opener.open(urllib.request.Request("https://registry-1.docker.io/v2/", headers={"User-Agent": f"arenactl/{VERSION}"}), timeout=20)
        return None
    except urllib.error.HTTPError as e:
        return None if e.code in (200, 401) else f"HTTP {e.code}"
    except (OSError, ValueError) as e:
        return str(getattr(e, "reason", e))


def docker_restart_notice(sudo: list[str], yes: bool) -> None:
    """What a restart of Docker stops, said before it is done, and a yes asked for."""
    rows = (output(["docker", "ps", "--format", "{{.Names}}\t{{.Label \"com.docker.compose.project\"}}"]) or "").split("\n")
    names = [r.split("\t")[0] for r in rows if r.strip()]
    policies = {}
    if names:
        out = output(["docker", "inspect", "--format", "{{.Name}}\t{{.HostConfig.RestartPolicy.Name}}", *names]) or ""
        policies = {ln.split("\t")[0].lstrip("/"): ln.split("\t")[1] for ln in out.splitlines() if "\t" in ln}
    stay = sorted(n for n in names if policies.get(n, "no") in ("no", ""))
    print("", file=sys.stderr)
    warn("THIS RESTARTS DOCKER. Before it goes on, know that:")
    for line in (
        f"every running container stops: {len(names)} now" + (f" ({', '.join(names[:12])}{', ...' if len(names) > 12 else ''})" if names else ""),
        "those with a restart policy start again by themselves (the stack's do): the site, chats in progress and "
        "engines are cut off until then, and the models load again (a minute or more for large ones)",
        f"these have no restart policy and STAY STOPPED until started by hand: {', '.join(stay)}" if stay else
        "every running container has a restart policy",
        "image builds, pulls and saves in progress (arenactl build, bundle, airgap) fail: run them again after",
        "from then on every pull goes through the proxy: while it is down, nothing can be pulled "
        "(./arenactl docker-proxy --off takes it away)",
        f"sudo writes {DOCKER_PROXY_CONF} and runs systemctl daemon-reload and restart docker" if sudo else
        f"{DOCKER_PROXY_CONF} is written, then systemctl daemon-reload and restart docker",
    ):
        print(f"  - {line}", file=sys.stderr)
    if yes:
        return
    if not sys.stdin.isatty():
        raise Stop("not asked at a terminal: run again with --yes to restart Docker", 2)
    answer = input("Type restart to go on (anything else stops): ").strip().lower()
    if answer != "restart":
        raise Stop("nothing changed: Docker was not restarted", 1)


def cmd_docker_proxy(a) -> int:
    """Docker's daemon given an HTTP proxy (a systemd drop-in), so its pulls and each build's FROM go through it too.
    Restarts Docker: its running containers stop, and those with a restart policy start again."""
    linux_only("Docker's proxy")
    if not shutil.which("systemctl"):
        raise Stop("Docker's daemon is not run by systemd here: give it the proxy in its own way (dockerd's HTTPS_PROXY)", 2)
    if not shutil.which("docker"):
        raise Stop(f"no Docker here ({how('docker')})", 3)
    sudo = [] if hasattr(os, "geteuid") and os.geteuid() == 0 else ["sudo"]
    url = None
    if not a.off:
        url = a.url or proxy()
        if not url:
            raise Stop("docker-proxy needs the proxy: ./arenactl docker-proxy http://HOST:PORT", 2)
        if not proxy():
            use_proxy(url)
        # A proxy that does not answer would leave Docker pulling nothing: checked before anything is changed.
        problem = proxy_answers(url)
        if problem:
            raise Stop(f"the proxy {masked(url)} does not reach Docker Hub's registry ({problem}): nothing changed. "
                       "Is it running, and does it take connections from this host (its LAN setting)?", 3)
        say(f"  the proxy {masked(url)} reaches Docker Hub's registry")
    elif not Path(DOCKER_PROXY_CONF).exists():
        say(f"Docker's daemon has no proxy of arenactl's ({DOCKER_PROXY_CONF} is not there): nothing to do")
        return 0
    docker_restart_notice(sudo, a.yes)
    if a.off:
        step(f"Docker's daemon without a proxy: {DOCKER_PROXY_CONF} removed")
        run([*sudo, "rm", "-f", str(DOCKER_PROXY_CONF)])
    else:
        no = os.environ.get("NO_PROXY", NO_PROXY)
        conf = f'[Service]\nEnvironment="HTTP_PROXY={url}" "HTTPS_PROXY={url}" "NO_PROXY={no}"\n'
        step(f"Docker's daemon through {masked(url)}: {DOCKER_PROXY_CONF}")
        run([*sudo, "mkdir", "-p", str(DOCKER_PROXY_CONF.parent)])
        r = subprocess.run([*sudo, "tee", str(DOCKER_PROXY_CONF)], input=conf, text=True, stdout=subprocess.DEVNULL)
        if r.returncode != 0:
            raise Stop(f"could not write {DOCKER_PROXY_CONF}", r.returncode)
        run([*sudo, "chmod", "600", str(DOCKER_PROXY_CONF)])
    step("Docker restarted")
    run([*sudo, "systemctl", "daemon-reload"])
    run([*sudo, "systemctl", "restart", "docker"])
    got = (output(["docker", "info", "--format", "{{.HTTPSProxy}}"]) or "").strip()
    say(f"Docker's daemon: {'proxy ' + masked(got) if got else 'no proxy'}")
    down = sorted(set((output(["docker", "ps", "-a", "--filter", "status=exited", "--format", "{{.Names}}"]) or "").split()))
    if down:
        say(f"  stopped now (start those you need: docker start NAME): {', '.join(down[:20])}{' ...' if len(down) > 20 else ''}")
    return 0


def cmd_scripts(_a) -> int:
    say("arenactl's commands run these; docs/scripts.md says when to use each.")
    groups = [("deploy/scripts: running a stack", SCRIPTS), ("tools: building and releasing", TOOLS)]
    for title, folder in groups:
        say("")
        say(title)
        for p in sorted(folder.iterdir()):
            if p.is_file() and p.suffix in (".sh", ".py", "") and not p.name.startswith((".", "_")) and p.name != "README.md":
                say(f"  {p.name:28} {first_line(p)}")
    return 0


# ----------------------------------------------------------------------------- the command line
def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="arenactl", description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog="Each command's own --help says more; docs/scripts.md has them all.")
    p.add_argument("--proxy", metavar="URL",
                   help="an HTTP proxy for everything downloaded (http://HOST:PORT; also ARENA_PROXY): arenactl's own "
                        "downloads, every image build's apt, pip, npm and curl, and the SDK's containers. The images "
                        "pulled are the engine's: its own proxy setting (docs/deployment.md, Building through a proxy)")
    sub = p.add_subparsers(dest="command", metavar="COMMAND")

    s = sub.add_parser("doctor", help="what this machine has for a task, and how to get the rest")
    s.add_argument("--for", dest="for_", choices=["build", "code-arena", "bundle", "install", "all"], default="all")
    s.add_argument("rest", nargs=argparse.REMAINDER, help="for install: the installer's requirements options (--podman, --cpu-only)")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("build", help="build the stack's images, and pull the others")
    s.add_argument("--with", dest="with_", help="features on beside the defaults (deploy/features)")
    s.add_argument("--without", help="features left out")
    s.add_argument("--all", action="store_true", help="every feature's images (a bundle needs them all)")
    s.add_argument("--services", help="only these services")
    s.add_argument("--no-pull", action="store_true", help="build only; pull nothing")
    s.add_argument("--engine", choices=["docker", "podman"])
    s.set_defaults(func=cmd_build)

    s = sub.add_parser("code-arena", help="Code Arena's packages for each system (dist/code-arena-VERSION-RID.tar.gz or .zip)")
    s.add_argument("rids", nargs="*", metavar="RID", help=f"the systems (default all: {' '.join(RIDS)})")
    s.add_argument("--offline", action="store_true", help="the .NET packs from tools/offline-nuget only, nothing downloaded")
    s.add_argument("--no-web", action="store_true", help="without the web interface's page")
    s.add_argument("--out", help="where the packages go (default dist/)")
    s.add_argument("--engine", choices=["docker", "podman"], help="the engine for the SDK's and Node's containers, without them installed")
    s.set_defaults(func=cmd_code_arena)

    s = sub.add_parser("deps", help="Docker, Compose and NVIDIA's container toolkit for a bundle (dist/deps/ARCH)")
    s.add_argument("--arch", choices=["amd64", "arm64"], default="arm64" if platform.machine().lower() in ("aarch64", "arm64") else "amd64")
    s.add_argument("--out")
    s.add_argument("--refresh", action="store_true", help="fetch again what is there already")
    s.set_defaults(func=cmd_deps)

    s = sub.add_parser("bundle", help="the offline installer, dist/arena-VERSION-offline.run")
    s.add_argument("--with-deps", action="store_true", help="Docker, Compose and NVIDIA's toolkit inside it, installed from it where missing")
    s.add_argument("--models", action="store_true", help="the models too")
    s.add_argument("--no-chat-models", action="store_true", help="with --models: every model but the chat models (each site brings its own)")
    s.add_argument("--models-dir")
    s.add_argument("--packs", action="store_true", help="the knowledge packs in packs/")
    s.add_argument("--without", help="features left out of the bundle")
    s.add_argument("--code-arena", help="Code Arena's packages from this folder (default dist/, made when missing)")
    s.add_argument("--out", help="where the .run goes (default dist/)")
    s.add_argument("--image-cache", help="each image packed once, by its id and name (default OUT/.image-cache): unchanged ones are not saved again")
    s.add_argument("--no-image-cache", action="store_true", help="every image saved and gzipped again")
    s.add_argument("--no-build", action="store_true", help="the images as they are here")
    s.add_argument("--podman", action="store_true")
    s.add_argument("--engine", choices=["docker", "podman"])
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(func=cmd_bundle)

    for c in INSTALLER_COMMANDS:
        s = sub.add_parser(c, help=f"the installer's {c} (deploy/scripts/installer.sh {c} --help)", add_help=False)
        if c in ("install", "upgrade", "repair"):
            s.add_argument("--no-build", action="store_true", help="the images as they are in the engine")
        s.add_argument("rest", nargs=argparse.REMAINDER)
        s.set_defaults(func=cmd_installer, no_build=False)

    for c, (_, text) in OPS.items():
        s = sub.add_parser(c, help=text, add_help=False)
        s.add_argument("rest", nargs=argparse.REMAINDER)
        s.set_defaults(func=cmd_ops)

    s = sub.add_parser("check", help="a live check of a running stack: " + ", ".join(CHECKS))
    s.add_argument("name", metavar="NAME")
    s.add_argument("rest", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("test", help="the test suites: app, code-arena, code-intel, web, deploy")
    s.add_argument("suites", nargs="*")
    s.add_argument("--filter")
    s.set_defaults(func=cmd_test)

    s = sub.add_parser("docker-proxy", help="Docker's daemon through an HTTP proxy too (its pulls), or --off; RESTARTS DOCKER, after a warning and a yes")
    s.add_argument("url", nargs="?", metavar="URL", help="http://HOST:PORT (default: --proxy or ARENA_PROXY)")
    s.add_argument("--off", action="store_true", help="the daemon without a proxy again")
    s.add_argument("--yes", action="store_true", help="restart Docker without asking (the warnings are still said)")
    s.set_defaults(func=cmd_docker_proxy)

    s = sub.add_parser("scripts", help="every script in the repository, by what it is for")
    s.set_defaults(func=cmd_scripts)

    try:
        # --proxy URL, anywhere on the line (before or after the command), for every command.
        argv, url = take_proxy(list(argv))
        use_proxy(url or os.environ.get("ARENA_PROXY"), daemon_hint=argv[:1] != ["docker-proxy"])
        # The commands that pass their options on to a script take them as they come (argparse would read them itself).
        if argv and argv[0] in INSTALLER_COMMANDS + tuple(OPS) + ("check", "doctor") and not (argv[0] in ("check", "doctor") and argv[1:2] in (["-h"], ["--help"])):
            cmd, rest = argv[0], list(argv[1:])
            if cmd == "doctor":
                task = "all"
                if "--for" in rest:
                    i = rest.index("--for")
                    task = rest[i + 1] if i + 1 < len(rest) else ""
                    del rest[i:i + 2]
                if task not in ("build", "code-arena", "bundle", "install", "all"):
                    raise Stop("--for is build, code-arena, bundle, install or all", 2)
                return cmd_doctor(argparse.Namespace(for_=task, rest=rest))
            if cmd == "check":
                if not rest:
                    raise Stop("check needs a name: " + ", ".join(CHECKS), 2)
                return cmd_check(argparse.Namespace(name=rest[0], rest=rest[1:]))
            if rest[:1] in (["-h"], ["--help"]):
                target = SCRIPTS / ("installer.sh" if cmd in INSTALLER_COMMANDS else OPS[cmd][0])
                return run(script_cmd(target, [cmd, "--help"] if cmd in INSTALLER_COMMANDS else ["--help"]), check=False, quiet=True)
            no_build = "--no-build" in rest
            ns = argparse.Namespace(command=cmd, rest=[x for x in rest if x != "--no-build"], no_build=no_build)
            return cmd_installer(ns) if cmd in INSTALLER_COMMANDS else cmd_ops(ns)
        a = p.parse_args(argv)
        if not a.command:
            p.print_help()
            return 2
        return a.func(a)
    except Stop as e:
        print(f"arenactl: {e}", file=sys.stderr)
        return e.code
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
