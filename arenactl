# ----------------------------------------------------------------------------- output
def say(msg: str = "") -> None:
    print(msg, flush=True)


def step(msg: str) -> None:
    print(f"==> {msg}", flush=True)


def warn(msg: str) -> None:
    print(f"arenactl: WARNING: {msg}", file=sys.stderr, flush=True)


class Stop(Exception):
    """A clear reason to stop, said once, with what to do."""

    def __init__(self, msg: str, code: int = 1):
        super().__init__(msg)
        self.code = code


def human(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def run(cmd: list[str], cwd: Path | None = None, env: dict | None = None, check: bool = True, quiet: bool = False, input: str | None = None) -> int:
    if not quiet:
        say("  $ " + " ".join(cmd))
    full = None if env is None else {**os.environ, **env}
    r = subprocess.run(cmd, cwd=cwd, env=full, input=input, text=input is not None)
    if check and r.returncode != 0:
        raise Stop(f"{Path(cmd[0]).name} failed (exit {r.returncode}): {' '.join(cmd)}", r.returncode)
    return r.returncode


def output(cmd: list[str], cwd: Path | None = None, env: dict | None = None) -> str | None:
    try:
        full = None if env is None else {**os.environ, **env}
        r = subprocess.run(cmd, cwd=cwd, env=full, capture_output=True, text=True, timeout=120)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def version_of(text: str | None) -> tuple[int, ...]:
    m = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", text or "")
    return tuple(int(x or 0) for x in m.groups()) if m else ()


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def free_bytes(path: Path) -> int:
    p = path
    while not p.exists():
        p = p.parent
    return shutil.disk_usage(p).free


def linux_only(what: str) -> None:
    if platform.system() != "Linux":
        raise Stop(f"{what} runs on Linux, where the stack runs (this is {platform.system()}): copy the bundle there "
                   f"(./arenactl bundle makes it) and run it with sh argus-arena-{VERSION}-offline.run install", 3)


# ----------------------------------------------------------------------------- the container engine
class Engine:
    """Docker, else Podman: whichever answers. Building, bundling and installing need one."""

    def __init__(self, name: str | None = None):
        self.name = name or self.pick()

    @staticmethod
    def answers(name: str) -> bool:
        return shutil.which(name) is not None and output([name, "info"]) is not None

    @classmethod
    def pick(cls) -> str | None:
        for name in ("docker", "podman"):
            if cls.answers(name):
                return name
        return None

    @property
    def ok(self) -> bool:
        return self.name is not None

    def need(self) -> str:
        if not self.name:
            raise Stop("neither Docker nor Podman answers here (installed, and its daemon or socket running?): ./arenactl doctor says how to get one", 3)
        return self.name

    def compose(self) -> list[str]:
        return [self.need(), "compose"]

    def has_image(self, ref: str) -> bool:
        return output([self.need(), "image", "inspect", ref]) is not None

    def user_args(self) -> list[str]:
        # The files a container writes into the checkout are this user's (Docker on Linux would make them root's).
        if self.name == "docker" and hasattr(os, "getuid"):
            return ["-u", f"{os.getuid()}:{os.getgid()}"]
        return []


# ----------------------------------------------------------------------------- features (deploy/features)
def features() -> list[dict]:
    """id | default | services | needs | requires | title, as deploy/features lists them."""
    rows = []
    for line in (DEPLOY / "features").read_text(encoding="utf-8").splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = [p.strip() for p in line.split("|")]
        if len(parts) < 6:
            continue
        rows.append({"id": parts[0], "default": parts[1] == "on", "services": [] if parts[2] == "-" else parts[2].split(),
                     "needs": [] if parts[3] == "-" else parts[3].split(","), "requires": [] if parts[4] == "-" else parts[4].split(","), "title": parts[5]})
    return rows


def choose_features(with_: str | None, without: str | None, all_: bool = False, cpu_only: bool = False) -> list[str]:
    rows = {f["id"]: f for f in features()}
    asked = {n for n in (with_ or "").split(",") if n}
    left = {n for n in (without or "").split(",") if n}
    for name in asked | left:
        if name not in rows:
            raise Stop(f"--with/--without {name}: no such feature (deploy/features: {', '.join(rows)})", 2)

    def hold(ids: set[str]) -> set[str]:
        # As the installer: a feature whose requirements are off goes too.
        ids = set(ids)
        while any(not set(rows[i]["requires"]) <= ids for i in ids):
            ids = {i for i in ids if set(rows[i]["requires"]) <= ids}
        return ids

    on = set(rows) if all_ else {i for i, f in rows.items() if f["default"]}
    if cpu_only:
        on -= {i for i, f in rows.items() if "gpu" in f["needs"] and i not in asked}
    on = hold(on)
    # A feature asked for brings those it requires.
    todo = list(asked)
    while todo:
        i = todo.pop()
        if i not in on:
            on.add(i)
            todo += rows[i]["requires"]
    return sorted(hold(on - left))


class Compose:
    """The release's compose file with placeholder secrets: enough to build, pull and list its images."""

    def __init__(self, engine: Engine, profiles: list[str], project: str = "arena"):
        self.engine = engine
        self.profiles = profiles
        self.project = project
        self.dir = Path(tempfile.mkdtemp(prefix="arenactl-"))
        (self.dir / "placeholder.env").write_text("".join(f"{k}=placeholder\n" for k in PLACEHOLDERS) + "DATA_DIR=/placeholder\n", encoding="utf-8")

    def env(self) -> dict:
        return {"COMPOSE_PROFILES": ",".join(self.profiles), "COMPOSE_PROJECT_NAME": self.project, "COMPOSE_FILE": ""}

    def cmd(self, *args: str) -> list[str]:
        files = ["-f", "docker-compose.yml"] + (["-f", "podman.yml"] if self.engine.name == "podman" else [])
        return [*self.engine.compose(), "--env-file", str(self.dir / "placeholder.env"), *files, *args]

    def run(self, *args: str) -> None:
        run(self.cmd(*args), cwd=DEPLOY, env=self.env())

    def config(self) -> dict:
        out = output(self.cmd("config", "--format", "json"), cwd=DEPLOY, env=self.env())
        if out is None:
            raise Stop("compose could not read deploy/docker-compose.yml (an old compose? version 2.20 or newer is needed)")
        return json.loads(out)

    def close(self) -> None:
        shutil.rmtree(self.dir, ignore_errors=True)


# ----------------------------------------------------------------------------- doctor
HOW = {
    "docker": {"Linux": "./arenactl requirements --fix installs Docker from Docker's packages (or https://docs.docker.com/engine/install/)",
               "Darwin": "Docker Desktop: https://docs.docker.com/desktop/setup/install/mac-install/",
               "Windows": "Docker Desktop: https://docs.docker.com/desktop/setup/install/windows-install/"},
    "compose": {"Linux": "Docker's compose plugin, 2.20 or newer (./arenactl requirements --fix installs it)", "Darwin": "comes with Docker Desktop", "Windows": "comes with Docker Desktop"},
    "dotnet": {"any": ".NET SDK 10 (https://dotnet.microsoft.com/download/dotnet/10.0); without it, Docker or Podman builds in the SDK's container"},
    "node": {"any": "Node.js 20 or newer with npm (https://nodejs.org); without it, Docker or Podman builds the page in Node's container"},
    "git": {"Linux": "your package manager: apt install git, dnf install git", "Darwin": "xcode-select --install", "Windows": "https://git-scm.com/download/win"},
    "openssl": {"Linux": "apt install openssl, dnf install openssl", "any": "OpenSSL"},
}


def how(tool: str) -> str:
    h = HOW.get(tool, {})
    return h.get(platform.system()) or h.get("any") or ""


def doctor_checks(task: str, engine: Engine) -> list[tuple[str, bool, str, bool]]:
    """(what, ok, detail or how, needed) for a task: build, code-arena, bundle, install or all."""
    rows: list[tuple[str, bool, str, bool]] = []
    tasks = {"build", "code-arena", "bundle", "install"} if task == "all" else {task} | ({"build", "code-arena"} if task == "bundle" else set())
    py = sys.version_info
    rows.append(("Python 3.8+", py >= (3, 8), f"{py.major}.{py.minor}", True))
    engine_needed = bool(tasks & {"build", "bundle", "install"})
    if engine.ok:
        ver = output([engine.name, "version", "--format", "{{.Server.Version}}"]) or output([engine.name, "--version"])
        rows.append((f"container engine ({engine.name})", True, (ver or "").strip(), engine_needed))
        cv = output([*engine.compose(), "version", "--short"]) or output([*engine.compose(), "version"])
        rows.append(("compose 2.20+", version_of(cv) >= (2, 20), (cv or "missing").strip() + ("" if version_of(cv) >= (2, 20) else f": {how('compose')}"), engine_needed))
    else:
        installed = [n for n in ("docker", "podman") if shutil.which(n)]
        detail = f"{' and '.join(installed)} installed, but its daemon does not answer (start it; on Linux: sudo systemctl start docker, or add yourself to the docker group)" if installed else how("docker")
        rows.append(("container engine (Docker or Podman)", False, detail, engine_needed))
    if tasks & {"code-arena"}:
        dv = output(["dotnet", "--list-sdks"])
        sdk10 = any(version_of(line) >= (10,) for line in (dv or "").splitlines())
        rows.append((".NET SDK 10", sdk10 or engine.ok, "installed" if sdk10 else ("not installed: builds in the SDK's container" if engine.ok else how("dotnet")), True))
        nv = output(["node", "--version"])
        node = version_of(nv) >= (20,) and shutil.which("npm") is not None
        page = (ROOT / "src" / "CodeArena" / "web" / "code-arena.html").exists()
        rows.append(("Node.js 20+ and npm (Code Arena's page)", node or engine.ok or page, nv.strip() if node else ("not installed: built in Node's container" if engine.ok else ("not installed: the page built already is used" if page else how("node"))), True))
    if tasks & {"bundle"}:
        rows.append(("git (each release's files, for upgrades)", shutil.which("git") is not None and (ROOT / ".git").exists(),
                     "a clone of the repository" if (ROOT / ".git").exists() else "not a git clone: the bundle cannot tell files a host changed on an upgrade from 5.2.0 (fresh installs are fine)", False))
        for tool in ("bash", "tar", "gzip", "sha256sum"):
            rows.append((tool, shutil.which(tool) is not None, "" if shutil.which(tool) else "the bundle is made on Linux (or WSL2), with GNU tools", True))
    if tasks & {"build", "bundle"}:
        free = free_bytes(ROOT)
        need = 120 << 30 if "bundle" in tasks else 60 << 30
        rows.append((f"free disk here ({human(need)}+)", free >= need, f"{human(free)} free in {ROOT}", True))
        if engine.ok and engine.name == "docker":
            root = (output(["docker", "info", "--format", "{{.DockerRootDir}}"]) or "").strip()
            if root and Path(root).exists():
                ef = free_bytes(Path(root))
                rows.append((f"free disk for images ({human(need)}+)", ef >= need, f"{human(ef)} free in {root}", True))
    if tasks & {"install"}:
        rows.append(("Linux", platform.system() == "Linux", platform.system(), True))
        rows.append(("openssl", shutil.which("openssl") is not None, "" if shutil.which("openssl") else how("openssl"), True))
    return rows


def cmd_doctor(a) -> int:
    engine = Engine()
    rows = doctor_checks(a.for_, engine)
    say(f"Argus Arena {VERSION}, for {a.for_}: {platform.system()} {platform.machine()}")
    bad = 0
    for what, ok, detail, needed in rows:
        mark = "ok     " if ok else ("MISSING" if needed else "note   ")
        bad += 0 if ok or not needed else 1
        say(f"  {mark} {what}{': ' + detail if detail else ''}")
    if a.for_ in ("install", "all") and platform.system() == "Linux":
        say("")
        step("the host, as the installer checks it (installer.sh requirements)")
        rc = run(["bash", str(SCRIPTS / "installer.sh"), "requirements", *a.rest], check=False, quiet=True)
        bad += 0 if rc == 0 else 1
    say("")
    say("Everything needed is here." if bad == 0 else f"{bad} thing(s) needed are missing (above, each with what to do).")
    return 0 if bad == 0 else 1


# ----------------------------------------------------------------------------- build
def build_images(engine: Engine, profiles: list[str], pull: bool = True, services: list[str] | None = None) -> None:
    compose = Compose(engine, profiles)
    try:
        cfg = compose.config()
        svcs = cfg.get("services", {})
        names = services or sorted(svcs)
        built = [s for s in names if s in svcs and svcs[s].get("build")]
        others = [s for s in names if s in svcs and not svcs[s].get("build")]
        step(f"the release's own images: {len(built)} built ({engine.name} compose build)")
        if built:
            compose.run("build", *built)
        if pull and others:
            missing = [s for s in others if not engine.has_image(svcs[s].get("image", ""))]
            step(f"the other images: {len(others)}, {len(missing)} pulled")
            if missing:
                compose.run("pull", *missing)
    finally:
        compose.close()


def cmd_build(a) -> int:
    engine = Engine(a.engine)
    profiles = choose_features(a.with_, a.without, a.all)
    say(f"Building Argus Arena {VERSION}'s images with {engine.need()}; features: {', '.join(profiles)}")
    build_images(engine, profiles, pull=not a.no_pull, services=a.services.split(",") if a.services else None)
    say("Built.")
    return 0


