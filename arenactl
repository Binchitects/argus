def script_cmd(path: Path, args: list[str]) -> list[str]:
    if path.suffix == ".py":
        return [sys.executable, str(path), *args]
    return ["bash" if path.read_text(encoding="utf-8", errors="replace").startswith("#!/usr/bin/env bash") else "sh", str(path), *args]


def cmd_ops(a) -> int:
    script, _ = OPS[a.command]
    rest = list(a.rest)
    # The installation's own copy (--dir, else /srv/arena or ~/arena); else this checkout's deploy/.
    d = installation_dir(rest)
    if "--dir" in rest:
        i = rest.index("--dir")
        del rest[i:i + 2]
    base = (d / "deploy") if d else DEPLOY
    if a.command == "restore":
        rest = ["--restore", *rest]
    return run(script_cmd(base / "scripts" / script, rest), cwd=base, check=False, quiet=True)


def cmd_check(a) -> int:
    if a.name not in CHECKS:
        raise Stop("no check " + a.name + "; the checks: " + ", ".join(CHECKS), 2)
    return run(script_cmd(SCRIPTS / CHECKS[a.name][0], a.rest), cwd=DEPLOY, check=False, quiet=True)


