def dotnet_cmd(engine: Engine) -> tuple[list[str], str]:
    """How to run the .NET SDK 10: installed, else in its container with this checkout mounted."""
    sdks = output(["dotnet", "--list-sdks"]) or ""
    if any(version_of(line) >= (10,) for line in sdks.splitlines()):
        return ["dotnet"], "/"
    name = engine.need()
    # NuGet's cache in a volume of the engine's own, kept between runs (a folder of the host's is not always the
    # engine's host's: arenactl itself in a container). As root in there; what it writes into the checkout is
    # handed back to this user after (Docker on Linux; Podman and Docker Desktop map it already).
    owner = engine.user_args()[1] if engine.user_args() else ""
    chown = f'; rc=$?; find /repo/src /repo/dist -user 0 -exec chown {owner} {{}} + 2>/dev/null; exit $rc' if owner else ""
    return [name, "run", "--rm", "-e", "DOTNET_CLI_TELEMETRY_OPTOUT=1", "-e", "DOTNET_NOLOGO=1", "-v", "arenactl-nuget:/root/.nuget",
            "-v", f"{ROOT}:/repo", "-w", "/repo", DOTNET_SDK_IMAGE, "sh", "-c", 'dotnet "$@"' + chown, "dotnet"], "/repo"


def build_page(engine: Engine) -> None:
    """Code Arena's web page (code-arena web), built from src/web into src/CodeArena/web, which the program embeds."""
    web = ROOT / "src" / "web"
    page = ROOT / "src" / "CodeArena" / "web"
    configs = [["--config", "vite.code-arena.config.ts"], ["--config", "vite.preview.config.ts", "--outDir", "../CodeArena/web"]]
    nv = output(["node", "--version"])
    npm = shutil.which("npm")
    if version_of(nv) >= (20,) and npm:
        step(f"Code Arena's page (node {nv.strip()})")
        if not (web / "node_modules" / "vite" / "bin" / "vite.js").exists():
            run([npm, "ci", "--no-audit", "--no-fund"], cwd=web)
        for c in configs:
            run(["node", "node_modules/vite/bin/vite.js", "build", *c, "--logLevel", "warn"], cwd=web)
    elif engine.ok:
        step(f"Code Arena's page (in {NODE_IMAGE}: no Node.js 20+ here)")
        # Built in a copy inside the container (without the host's node_modules, another system's binaries); only the
        # page comes back into the checkout.
        script = ("mkdir -p /tmp/w/src && cd /repo/src && tar cf - --exclude=web/node_modules web | tar xf - -C /tmp/w/src && cd /tmp/w/src/web "
                  "&& npm ci --no-audit --no-fund && "
                  + " && ".join(f"node node_modules/vite/bin/vite.js build {' '.join(c)} --logLevel warn" for c in configs)
                  + " && rm -rf /repo/src/CodeArena/web && cp -r /tmp/w/src/CodeArena/web /repo/src/CodeArena/web")
        run([engine.name, "run", "--rm", *engine.user_args(), "-e", "HOME=/tmp", "-e", "npm_config_cache=/tmp/.npm", "-v", f"{ROOT}:/repo",
             NODE_IMAGE, "sh", "-c", script])
    elif (page / "code-arena.html").exists():
        say("==> Code Arena's page: built already (no Node.js 20+ or container engine to build it again)")
    else:
        raise Stop(f"Code Arena's page needs Node.js 20+ ({how('node')}) or Docker; --no-web builds without it")


def cmd_code_arena(a) -> int:
    rids = a.rids or RIDS
    for r in rids:
        if r not in RIDS:
            raise Stop(f"no system {r} (systems: {' '.join(RIDS)})", 2)
    engine = Engine(a.engine)
    out = Path(a.out).resolve() if a.out else DIST
    say(f"Code Arena {VERSION} for {', '.join(rids)}, into {out}")
    if a.no_web:
        shutil.rmtree(ROOT / "src" / "CodeArena" / "web", ignore_errors=True)
    else:
        build_page(engine)
    dotnet, base = dotnet_cmd(engine)
    rel = (lambda p: str(p)) if base == "/" else (lambda p: "/repo/" + p.relative_to(ROOT).as_posix())
    sources: list[str] = []
    if a.offline:
        runtime = (output([*dotnet, "msbuild", rel(ROOT / "src/CodeArena/CodeArena.csproj"), "-getProperty:BundledNETCoreAppPackageVersion"], cwd=ROOT) or "").strip().splitlines()
        runtime = runtime[-1].strip() if runtime else ""
        if not re.fullmatch(r"\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?", runtime):
            raise Stop(f"the .NET SDK did not say which runtime it publishes with: {runtime!r}")
        have = {p.name.lower() for p in (TOOLS / "offline-nuget").glob("*.nupkg")}
        missing = [f"microsoft.netcore.app.{k}.{r}.{runtime}.nupkg" for r in rids for k in ("runtime", "host") if f"microsoft.netcore.app.{k}.{r}.{runtime}.nupkg" not in have]
        if missing:
            raise Stop("--offline: tools/offline-nuget lacks " + ", ".join(missing) + " (tools/fetch-code-arena-packs.sh fetches them; without --offline nuget.org is used)", 3)
        sources = ["--source", rel(TOOLS / "offline-nuget"), "-p:RestoreIgnoreFailedSources=false"]
    built = DIST / "code-arena"
    for rid in rids:
        step(f"Code Arena for {rid}")
        target = built / rid
        shutil.rmtree(target, ignore_errors=True)
        run([*dotnet, "publish", rel(ROOT / "src/CodeArena/CodeArena.csproj"), "-c", "Release", "-r", rid, "-o", rel(target), *sources, "-nologo"], cwd=ROOT)
        for f in target.iterdir():
            if f.is_file() and f.name not in ("code-arena", "code-arena.exe"):
                f.unlink()
    step("the packages")
    out.mkdir(parents=True, exist_ok=True)
    epoch = int(os.environ.get("SOURCE_DATE_EPOCH") or (output(["git", "-C", str(ROOT), "log", "-1", "--format=%ct"]) or str(int(time.time()))).strip())
    for rid in rids:
        exe = "code-arena.exe" if rid.startswith("win-") else "code-arena"
        name = f"code-arena-{VERSION}-{rid}"
        files = [(f"{name}/{exe}", (built / rid / exe).read_bytes(), 0o755), (f"{name}/LICENSE.md", (ROOT / "LICENSE.md").read_bytes(), 0o644),
                 (f"{name}/LICENSING.md", (ROOT / "LICENSING.md").read_bytes(), 0o644)]
        text = readme(rid, exe)
        files.append((f"{name}/README.txt", (text.replace("\n", "\r\n") if rid.startswith("win-") else text).encode(), 0o644))
        files.sort()
        for old in (out / f"{name}.tar.gz", out / f"{name}.zip"):
            old.unlink(missing_ok=True)
        # The same files give the same package: no owners, the commit's time on every file.
        if rid.startswith("win-"):
            path = out / f"{name}.zip"
            with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as z:
                stamp = time.gmtime(max(epoch, 315532800))[:6]
                for arc, data, mode in files:
                    info = zipfile.ZipInfo(arc, stamp)
                    info.external_attr = (0o100000 | mode) << 16
                    info.compress_type = zipfile.ZIP_DEFLATED
                    z.writestr(info, data)
        else:
            path = out / f"{name}.tar.gz"
            import gzip
            import io
            raw = io.BytesIO()
            with tarfile.open(fileobj=raw, mode="w", format=tarfile.PAX_FORMAT) as t:
                d = tarfile.TarInfo(name)
                d.type, d.mode, d.mtime, d.uid, d.gid = tarfile.DIRTYPE, 0o755, epoch, 0, 0
                t.addfile(d)
                for arc, data, mode in files:
                    info = tarfile.TarInfo(arc)
                    info.size, info.mode, info.mtime, info.uid, info.gid = len(data), mode, epoch, 0, 0
                    t.addfile(info, io.BytesIO(data))
            with open(path, "wb") as f, gzip.GzipFile(filename="", mode="wb", fileobj=f, compresslevel=9, mtime=0) as g:
                g.write(raw.getvalue())
        say(f"  {path.name}: {human(path.stat().st_size)}")
    sums = sorted(p for p in out.iterdir() if p.is_file() and re.fullmatch(rf"code-arena-{re.escape(VERSION)}-[a-z0-9-]+\.(tar\.gz|zip)", p.name))
    (out / "SHA256SUMS").write_text("".join(f"{sha256(p)}  {p.name}\n" for p in sums), encoding="utf-8")
    say(f"  SHA256SUMS: {len(sums)} packages")
    return 0


# ----------------------------------------------------------------------------- dependencies for a bundle
def fetch(url: str, dest: Path) -> Path:
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_name(dest.name + ".part")
    req = urllib.request.Request(url, headers={"User-Agent": f"arenactl/{VERSION}"})
    with urllib.request.urlopen(req, timeout=120) as r, open(part, "wb") as f:
        shutil.copyfileobj(r, f, 1 << 20)
    part.replace(dest)
    return dest


def fetch_text(url: str) -> str:
    req = urllib.request.Request(url, headers={"User-Agent": f"arenactl/{VERSION}", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read().decode()


def latest_release(repo: str) -> dict:
    return json.loads(fetch_text(f"https://api.github.com/repos/{repo}/releases/latest"))


def cmd_deps(a) -> int:
    """Docker's static binaries, its compose plugin, and NVIDIA's container toolkit (deb and rpm), for a bundle's deps/."""
    arch = a.arch
    out = Path(a.out).resolve() if a.out else DIST / "deps" / arch
    machine = {"amd64": "x86_64", "arm64": "aarch64"}[arch]
    rows: list[tuple[str, str, str]] = []
    step(f"the host's dependencies for a bundle, {arch}, into {out}")
    # Docker: the newest static release (a tgz of dockerd, containerd, runc and the CLI: any Linux).
    index = fetch_text(f"https://download.docker.com/linux/static/stable/{machine}/")
    versions = sorted({tuple(map(int, m)) for m in re.findall(r"docker-(\d+)\.(\d+)\.(\d+)\.tgz", index)})
    if not versions:
        raise Stop("download.docker.com listed no static Docker release")
    dv = ".".join(map(str, versions[-1]))
    f = out / "docker" / f"docker-{dv}.tgz"
    if not f.exists() or a.refresh:
        say(f"  Docker {dv} (static) ...")
        fetch(f"https://download.docker.com/linux/static/stable/{machine}/docker-{dv}.tgz", f)
    rows.append(("docker", dv, f.relative_to(out).as_posix()))
    # Compose: the plugin binary, checked against the release's own checksum.
    rel = latest_release("docker/compose")
    cv = rel["tag_name"].lstrip("v")
    asset = f"docker-compose-linux-{machine}"
    f = out / "docker" / "docker-compose"
    if not f.exists() or a.refresh:
        say(f"  Docker Compose {cv} ...")
        url = next(x["browser_download_url"] for x in rel["assets"] if x["name"] == asset)
        fetch(url, f)
        want = next((x["browser_download_url"] for x in rel["assets"] if x["name"] == asset + ".sha256"), None)
        if want and fetch_text(want).split()[0] != sha256(f):
            f.unlink()
            raise Stop(f"Docker Compose {cv}: the download does not match its checksum")
    f.chmod(0o755)
    rows.append(("docker-compose", cv, f.relative_to(out).as_posix()))
    # NVIDIA's container toolkit: its packages for Debian/Ubuntu and for RHEL/Fedora/SUSE.
    rel = latest_release("NVIDIA/nvidia-container-toolkit")
    nv = rel["tag_name"].lstrip("v")
    for kind, tag in (("deb", "amd64" if arch == "amd64" else "arm64"), ("rpm", machine)):
        name = next((x for x in rel["assets"] if re.search(rf"_{kind}_{tag}\.tar\.gz$", x["name"])), None)
        if name is None:
            warn(f"NVIDIA's container toolkit {nv} has no {kind} packages for {tag}: left out")
            continue
        f = out / "nvidia" / name["name"]
        if not f.exists() or a.refresh:
            say(f"  NVIDIA container toolkit {nv} ({kind}) ...")
            fetch(name["browser_download_url"], f)
        rows.append((f"nvidia-container-toolkit-{kind}", nv, f.relative_to(out).as_posix()))
    (out / "DEPS").write_text("".join(f"{n}\t{v}\t{p}\t{arch}\t{sha256(out / p)}\n" for n, v, p in rows), encoding="utf-8")
    total = sum((out / p).stat().st_size for _, _, p in rows)
    for n, v, p in rows:
        say(f"  {n} {v}: {p} ({human((out / p).stat().st_size)})")
    say(f"  {human(total)} in {out}")
    return 0


# ----------------------------------------------------------------------------- the offline bundle
def release_tag_missing() -> bool:
    if not (ROOT / ".git").exists() or shutil.which("git") is None:
        return True
    return not (output(["git", "-C", str(ROOT), "tag", "-l", "v5.2.0"]) or "").strip()


def cmd_bundle(a) -> int:
    engine = Engine("podman" if a.podman else a.engine)
    rows = doctor_checks("bundle", engine)
    missing = [f"{w}: {d}" for w, ok, d, needed in rows if needed and not ok]
    if missing and not a.dry_run:
        raise Stop("the bundle needs:\n  " + "\n  ".join(missing) + "\n(./arenactl doctor --for bundle)", 3)
    linux_only("Making the bundle")
    profiles = choose_features(None, a.without, all_=True)
    if not a.no_build and not a.dry_run:
        build_images(engine, profiles)
    if not a.code_arena and not list(DIST.glob(f"code-arena-{VERSION}-*")) and not a.dry_run:
        step("Code Arena's packages: none of this version in dist/, made now")
        cmd_code_arena(argparse.Namespace(rids=None, offline=False, no_web=False, out=None, engine=engine.name))
    no_known = False
    if release_tag_missing():
        if (ROOT / ".git").exists() and shutil.which("git"):
            run(["git", "-C", str(ROOT), "fetch", "--tags", "--quiet"], check=False)
        if release_tag_missing():
            warn("no git tag v5.2.0 here: the bundle installs and repairs as usual, but an upgrade from 5.2.0 cannot tell "
                 "the files a host changed from those it was shipped with (it keeps every one it finds changed, with the release's beside it)")
            no_known = True
    deps_dir = None
    if a.with_deps:
        arch = "arm64" if platform.machine().lower() in ("aarch64", "arm64") else "amd64"
        deps_dir = DIST / "deps" / arch
        if not (deps_dir / "DEPS").exists() and not a.dry_run:
            cmd_deps(argparse.Namespace(arch=arch, out=None, refresh=False))
    cmd = ["bash", str(SCRIPTS / "make-installer.sh"), "--project", "arena"]
    if engine.name == "podman":
        cmd.append("--podman")
    for flag, value in (("--out", a.out), ("--models-dir", a.models_dir), ("--code-arena", a.code_arena), ("--without", a.without)):
        if value:
            cmd += [flag, value]
    cmd += (["--models"] if a.models else []) + (["--packs"] if a.packs else []) + (["--no-known"] if no_known else []) + (["--dry-run"] if a.dry_run else [])
    if deps_dir:
        cmd += ["--deps", str(deps_dir)]
    step("the bundle (deploy/scripts/make-installer.sh)")
    return run(cmd, check=False)


# ----------------------------------------------------------------------------- the installer, from this checkout
INSTALLER_COMMANDS = ("install", "upgrade", "repair", "remove", "status", "verify", "features", "requirements")


def installation_dir(rest: list[str]) -> Path | None:
    if "--dir" in rest:
        i = rest.index("--dir")
        if i + 1 < len(rest):
            return Path(rest[i + 1]).expanduser().resolve()
    for d in (Path("/srv/arena"), Path.home() / "arena"):
        if (d / "deploy" / "scripts" / "installer.sh").exists():
            return d
    return None


def option(rest: list[str], name: str) -> str | None:
    vals = [rest[i + 1] for i, x in enumerate(rest[:-1]) if x == name]
    return ",".join(vals) if vals else None


def cmd_installer(a) -> int:
    rest = list(a.rest)
    if a.command in ("install", "upgrade", "repair"):
        linux_only(a.command.capitalize())
        engine = Engine("podman" if "--podman" in rest else ("docker" if "--docker" in rest else None))
        dry = "--dry-run" in rest
        if a.command in ("upgrade", "repair") and option(rest, "--with") is None:
            # The features on there, as its .env says: their images are the ones it needs.
            d = installation_dir(rest)
            env = (d / "deploy" / ".env") if d else None
            on = ""
            if env and env.exists():
                on = next((ln.split("=", 1)[1].strip().strip('"') for ln in env.read_text(encoding="utf-8").splitlines() if ln.startswith("COMPOSE_PROFILES=")), "")
            profiles = choose_features(on or None, option(rest, "--without")) if on else choose_features(None, option(rest, "--without"))
        else:
            profiles = choose_features(option(rest, "--with"), option(rest, "--without"), cpu_only="--cpu-only" in rest)
        if not a.no_build and not dry:
            say(f"{a.command.capitalize()} Argus Arena {VERSION} from this checkout ({ROOT}); its images first, features: {', '.join(profiles)}")
            build_images(engine, profiles)
        stage = Path(tempfile.mkdtemp(prefix="arenactl-bundle-", dir=os.environ.get("TMPDIR") or "/var/tmp"))
        try:
            step("the installer's bundle from this checkout (its images are the engine's)")
            mk = ["bash", str(SCRIPTS / "make-installer.sh"), "--images-in-engine", "--stage-only", str(stage)]
            if engine.name == "podman":
                mk.append("--podman")
            if release_tag_missing():
                mk.append("--no-known")
            run(mk, quiet=True)
            top = next(stage.glob("argus-arena-*"))
            return run(["bash", str(top / "installer.sh"), a.command, *rest], check=False, quiet=True)
        finally:
            shutil.rmtree(stage, ignore_errors=True)
    # The rest act on an installation: its own copy of the installer knows its folder.
    d = installation_dir(rest)
    installer = d / "deploy" / "scripts" / "installer.sh" if d and a.command != "requirements" else SCRIPTS / "installer.sh"
    return run(["bash", str(installer), a.command, *rest], check=False, quiet=True)


