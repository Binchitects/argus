# Context of the images built from the repository root: the API
# (src/Llm.Api/Dockerfile) and Argus (src/Argus/Dockerfile). They build from
# source; nothing prebuilt, secret or large crosses into the context.
.git
.github
.claude
.remember
.config

# Not needed by either image. deploy/ holds .env, backups and the models.
deploy/
docs/
evals/
clients/
tools/*
!tools/fetch-sqlite-vec.sh
!tools/publish-code-arena.sh
!tools/offline-nuget
# src/web stays for Code Arena's web interface (the API's code-arena-web stage), without what is built or downloaded.
src/web/dist/
src/web/test-results/
src/web/playwright-report/
src/web/e2e/.auth/
# Built in the image from src/web: never a local build.
src/CodeArena/web/
tests/Llm.Tests/
tests/deploy/

**/bin/
**/obj/
dist/
native/
**/node_modules/
src/argus-web/dist/
src/argus-web/test-results/
src/argus-web/playwright-report/
src/argus-web/e2e/.work/
TestResults/

data/
packs/
.packwork/
*.db
*.db-wal
*.db-shm
