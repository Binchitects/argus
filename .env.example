# Argus deployment configuration.
#
#   cp .env.example .env      then edit    then: ./deploy/bootstrap.sh
#
# .env is gitignored. Nothing in this file may ever be committed with real
# values in it -- the service token below can read every repository in your
# GitLab, so it is the single most sensitive string in the deployment.

# ---------------------------------------------------------------- GitLab ----

# Your self-hosted GitLab. Must be reachable from the index host.
ARGUS_GITLAB_URL=https://gitlab.your-company.internal

# The SERVICE token: a GitLab PAT with `read_api` + `read_repository` that can
# see EVERY repository you want indexed.
#
# It is deliberately privileged, and it must never leave the index host --
# never in a developer's Hermes config, never in a client. Developers
# authenticate with their OWN tokens, which Argus exchanges for their
# membership on every request. That separation is the whole security model.
ARGUS_GITLAB_TOKEN=

# ------------------------------------------------------------------ Serve ---

# Public hostname Caddy terminates TLS on. Used for the certificate, so it
# must resolve publicly (or use Caddy's internal CA for a private network).
ARGUS_PUBLIC_HOST=argus.your-company.internal

# Bind address INSIDE the container network. Leave as-is unless you know why.
ARGUS_BIND=0.0.0.0
ARGUS_PORT=7700

# Image tag to run. Pin a real version in production; :latest makes a rollback
# ambiguous at exactly the moment you need one.
ARGUS_VERSION=0.1.0-rc1

# ----------------------------------------------------------------- Ollama ---

# Embeddings for knowledge packs and semantic search. CPU-only works; a GPU
# changes the experience, because query embedding dominates what a user feels
# (measured: 2,254 ms median on CPU, versus milliseconds for the search).
#
# Ollama has NO AUTHENTICATION of its own. Bind it to localhost or firewall it
# to the developer subnet -- never expose it publicly.
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Where Ollama keeps its models. Point this at a disk with room: the chat
# models are tens of GB each.
OLLAMA_MODELS=/var/lib/ollama

# Context window Ollama serves. The value a model ADVERTISES is not the one
# Ollama uses -- it defaults far lower, and a large tool list then leaves
# almost no room to generate, which surfaces as a truncated or empty reply
# rather than an error.
OLLAMA_CONTEXT_LENGTH=131072
