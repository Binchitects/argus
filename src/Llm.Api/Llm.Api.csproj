<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="zxcvbn-core" Version="7.0.92" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Llm.Core\Llm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Models\engine-options.txt" LogicalName="engine-options.txt" />
    <EmbeddedResource Include="Chat\Tools\Blender\builder.py" LogicalName="blender-builder.py" />
    <EmbeddedResource Include="Lab\lab.py" LogicalName="lab.py" />
    <EmbeddedResource Include="Chat\Tools\Blender\epilogue.py" LogicalName="blender-epilogue.py" />
    <EmbeddedResource Include="Media\Scripts\cut-story.py" LogicalName="cut-story.py" />
    <EmbeddedResource Include="Vector\Icons\lucide.json" LogicalName="lucide.json" />
    <EmbeddedResource Include="../../docs/compliance/controls.yaml" LogicalName="compliance-controls.yaml" />
    <EmbeddedResource Include="../../docs/compliance/frameworks.yaml" LogicalName="compliance-frameworks.yaml" />
    <EmbeddedResource Include="../../docs/compliance/catalogs/*.yaml" LogicalName="compliance-catalogs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/compliance/policies/*.md;../../docs/compliance/isms.md" LogicalName="policy-templates/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../deploy/features" LogicalName="features" />
    <!-- The dashboards go into the image at /dashboards (Dockerfile), not beside the app. -->
    <Content Remove="Dashboards\json\**" />
    <None Include="Dashboards\json\**" />
  </ItemGroup>

  <!-- The skills that come with Arena (the repository's skills/ folder): the chat's and Code Arena's alike. -->
  <ItemGroup>
    <EmbeddedResource Include="../../skills/**/*" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
