    {
      "type": "table",
      "title": "Tokens and cost per person",
      "datasource": {
        "type": "postgres",
        "uid": "gateway-db"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "description": "Per person, every surface combined. Cost is what the gateway recorded per request.",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gateway-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(s.person, '(unattributed)') as \"Person\", count(*) as \"Requests\", sum(greatest(coalesce(s.prompt_tokens,0) - s.cached_tokens, 0)) as \"Input, cache miss\", sum(s.cached_tokens) as \"Input, cache hit\", round(100.0*sum(s.cached_tokens)/nullif(sum(coalesce(s.prompt_tokens,0)),0),1) as \"Cache hit %\", sum(coalesce(s.completion_tokens,0)) as \"Output\", round(sum(s.cost)::numeric,4) as \"Cost\" from requests s where $__timeFilter(s.started_at) and s.status <> 'refused' group by 1 order by \"Cost\" desc nulls last",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "By model",
      "datasource": {
        "type": "postgres",
        "uid": "gateway-db"
      },
      "description": "Per model: requests, tokens, the share of prompt tokens read from the engine's cache, the median time and the spend.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gateway-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model AS \"Model\", count(*) AS \"Requests\", COALESCE(sum(prompt_tokens),0) AS \"Prompt tokens\", COALESCE(sum(completion_tokens),0) AS \"Completion tokens\", COALESCE(round(100.0*sum(cached_tokens)/NULLIF(sum(coalesce(prompt_tokens,0)),0),1),0) AS \"Cache hit %\", round(COALESCE(percentile_cont(0.5) WITHIN GROUP (ORDER BY duration_ms),0)::numeric,0) AS \"p50 ms\", round(COALESCE(sum(cost),0)::numeric,4) AS \"Spend\" from requests WHERE $__timeFilter(started_at) AND status <> 'refused' GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Refused",
      "datasource": {
        "type": "postgres",
        "uid": "gateway-db"
      },
      "description": "Requests the gateway refused before any model: a key's rate limits (requests or tokens a minute, requests at once), credit or a budget, the safeguards, a key unknown, blocked or expired, a model the key may not use, no room on the model. Who, with which key, why, how often and when last. They are not counted as requests or failures in the other panels. The gateway keeps no prompt or answer with a refusal.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "gateway-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(s.person, '(unattributed)') as \"Person\", coalesce(s.key_alias, s.surface) as \"Key\", case s.refusal when 'rpm' then 'requests a minute' when 'tpm' then 'tokens a minute' when 'parallel' then 'requests at once' when 'budget' then 'a budget' when 'credit' then 'credit' when 'key' then 'unknown key' when 'blocked' then 'key blocked' when 'expired' then 'key expired' when 'disabled' then 'account disabled' when 'api_off' then 'API access off' when 'model' then 'model not allowed' when 'safeguards' then 'safeguards' when 'room' then 'no room on the model' when 'busy' then 'busy' when 'too_long' then 'too long' else 'other' end as \"Why\", count(*) as \"Refused\", max(s.started_at) as \"Last\" from requests s where $__timeFilter(s.started_at) and s.status = 'refused' group by 1,2,3 order by 4 desc, 5 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
