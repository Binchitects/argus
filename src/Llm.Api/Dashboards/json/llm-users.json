    {
      "type": "table",
      "title": "Tokens and cost per person",
      "datasource": {
        "type": "postgres",
        "uid": "litellm-db"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "description": "Per person, every surface combined. Cost is what the gateway recorded per request.",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "litellm-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(nullif(s.\"user\",''), s.metadata->>'user_api_key_user_id', v.user_id, nullif(s.end_user,''), '(unattributed)') as \"Person\", count(*) as \"Requests\", sum(greatest(coalesce(s.prompt_tokens,0) - coalesce((s.metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint, 0), 0)) as \"Input, cache miss\", sum(coalesce((s.metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint, 0)) as \"Input, cache hit\", round(100.0*sum(coalesce((s.metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint, 0))/nullif(sum(coalesce(s.prompt_tokens,0)),0),1) as \"Cache hit %\", sum(coalesce(s.completion_tokens,0)) as \"Output\", round(sum(s.spend)::numeric,4) as \"Cost\" from \"LiteLLM_SpendLogs\" s left join \"LiteLLM_VerificationToken\" v on v.token = s.api_key where $__timeFilter(s.\"startTime\") and coalesce(s.metadata->'error_information'->>'error_class','') <> 'ProxyRateLimitError' group by 1 order by \"Cost\" desc nulls last",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "By model",
      "datasource": {
        "type": "postgres",
        "uid": "litellm-db"
      },
      "description": "Per model: requests, tokens, the share of prompt tokens read from the engine's cache, the median time and the spend.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "litellm-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model AS \"Model\", count(*) AS \"Requests\", COALESCE(sum(prompt_tokens),0) AS \"Prompt tokens\", COALESCE(sum(completion_tokens),0) AS \"Completion tokens\", COALESCE(round(100.0*sum(coalesce((metadata->'usage_object'->'prompt_tokens_details'->>'cached_tokens')::bigint, 0))/NULLIF(sum(coalesce(prompt_tokens,0)),0),1),0) AS \"Cache hit %\", round(COALESCE(percentile_cont(0.5) WITHIN GROUP (ORDER BY request_duration_ms),0)::numeric,0) AS \"p50 ms\", round(COALESCE(sum(spend),0)::numeric,4) AS \"Spend\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND coalesce(metadata->'error_information'->>'error_class','') <> 'ProxyRateLimitError' GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Refused by rate limits",
      "datasource": {
        "type": "postgres",
        "uid": "litellm-db"
      },
      "description": "API requests the gateway refused (HTTP 429) for a key's rate limits: requests a minute, tokens a minute, or requests at once. Who, with which key, which limit, how often and when last. They are not counted as requests in the other panels. Refusals for credit are not here. The gateway keeps no prompt or answer with a refusal.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "litellm-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(nullif(s.\"user\",''), s.metadata->>'user_api_key_user_id', v.user_id, nullif(s.end_user,''), '(unattributed)') as \"Person\", coalesce(s.metadata->>'user_api_key_alias', v.key_alias, '(master key)') as \"Key\", case substring(s.metadata->'error_information'->>'error_message' from 'Limit type: ([a-z_]+)') when 'requests' then 'requests a minute' when 'tokens' then 'tokens a minute' when 'max_parallel_requests' then 'requests at once' else 'other' end as \"Limit\", count(*) as \"Refused\", max(s.\"startTime\") as \"Last\" from \"LiteLLM_SpendLogs\" s left join \"LiteLLM_VerificationToken\" v on v.token = s.api_key where $__timeFilter(s.\"startTime\") and s.status = 'failure' and s.metadata->'error_information'->>'error_class' = 'ProxyRateLimitError' group by 1,2,3 order by 4 desc, 5 desc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
