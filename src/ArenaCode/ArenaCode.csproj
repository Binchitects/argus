<Project Sdk="Microsoft.NET.Sdk">

  <!-- Arena Code: the coding agent people run on their own machine, against
       their Argus Arena. The base class library only, no package references:
       it builds with nothing but the SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>arena-code</AssemblyName>
    <RootNamespace>ArenaCode</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArenaCode.Tests" />
  </ItemGroup>

  <!-- The web interface (arena-code web): the page src/web builds into web/
       (tools/publish-arena-code.sh does it first), embedded whole. Without it,
       arena-code web says the page is missing. -->
  <ItemGroup Condition="Exists('web/arena-code.html')">
    <EmbeddedResource Include="web/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <None Remove="web/**/*" />
  </ItemGroup>

  <!-- Published for one system (tools/publish-arena-code.sh, -r <rid>): one
       self-contained file that runs where no .NET is installed. Only then: a
       plain build or test needs no runtime pack. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming and the single-file analyzer need the ILLink package, which the
         offline package folder does not hold. The code keeps clear of what the
         analyzer warns about (Assembly.Location and the like). -->
    <PublishTrimmed>false</PublishTrimmed>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- Only .NET's own runtime pack: not ASP.NET's or Windows Desktop's, which
         the SDK otherwise fetches in case a referenced project needs them. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
