[*.cs]
# Test names read as sentences (Liveness_is_ok); xUnit fixtures are "...Collection" by convention.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
# Test helpers read better as instance members.
dotnet_diagnostic.CA1822.severity = none
# RFC 6238 (TOTP) is defined on HMAC-SHA1; the tests compute authenticator codes with it.
dotnet_diagnostic.CA5350.severity = none
