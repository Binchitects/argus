<Project>
  <!-- Every .NET project in the repository: one framework, nullable and
       implicit usings on, and no warning left standing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Stamped by the image builds (APP_VERSION); the app shows it at /api/info. -->
    <Version Condition="'$(AppVersion)' != ''">$(AppVersion)</Version>
  </PropertyGroup>
</Project>
