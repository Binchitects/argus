<Project>
  <!-- Every .NET project in the repository: one framework, nullable and
       implicit usings on, and no warning left standing. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A vulnerability NuGet's audit learns of later (NU1901-NU1904) is reported but does not stop
         the build: a published advisory would otherwise break every build of an unchanged tree.
         The package is bumped deliberately, in its own commit. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- One version for every project and image: VERSION at the repository's root,
         bumped by each release (APP_VERSION overrides it for a one-off build).
         The app shows it at /api/info and in the sidebar; Argus in its metrics. -->
    <AppVersion Condition="'$(AppVersion)' == '' and Exists('$(MSBuildThisFileDirectory)VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</AppVersion>
    <Version Condition="'$(AppVersion)' != ''">$(AppVersion)</Version>
  </PropertyGroup>
</Project>
