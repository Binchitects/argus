# .NET
bin/
obj/
*.user
TestResults/
# sqlite-vec for Argus, fetched by tools/fetch-sqlite-vec.sh
/native/
# Written at run time by the API
src/Llm.Api/wwwroot/

# The web apps (each also has its own .gitignore)
src/web/node_modules/
src/web/dist/
src/argus-web/node_modules/
src/argus-web/dist/
src/argus-web/test-results/
src/argus-web/playwright-report/
src/argus-web/e2e/.work/

# Python (the stack's scripts and tools)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Runtime state (all rebuildable, or secret)
data/
*.db
*.db-wal
*.db-shm
.env
config.local.yaml
# Unanchored `config.yaml` is not ignored: the stack bind-mounts two committed ones.

# The test GitLab's seeded credentials and its data (throwaway, but still credentials)
tools/test-gitlab/seeded.json
tools/test-gitlab/work/

# Knowledge packs: built ones are hundreds of MB, published out of band. The
# leading slash matters: a bare `packs/` would also hide source directories.
/packs/
.packwork/
dist/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
.claude/
.remember/
