# ==============================================================================
# TITLE: Qwen3.8-27B (dense) on one RTX 5090
# HARDWARE: RTX 5090 32 GB, 32 GB RAM, NVMe
# DOWNLOAD: First start downloads 17.6 GB: the UD-Q4_K_XL model (its MTP layer is built in)
# STATUS: NOT measured: no RTX 5090 here. Same model and flags as the 3090 run; the extra 8 GB buys the full 256K window. Expect faster decode from the higher memory bandwidth.
# ==============================================================================
#
# This file is the whole deployment. There is no setup script.
#
#   1. cp env-samples/qwen3.8-27b.rtx5090.env .env
#   2. Fill in every empty value under SECRETS (each says how to make one).
#   3. Point LLAMACPP_MODEL_DIR at a directory on NVMe with room for the download.
#   4. docker compose up -d
#
# Then open https://admin.<LLM_DOMAIN> (user admin, password AUTHELIA_ADMIN_PASSWORD).
# The browser warns once about the self-signed certificate; accept it.
# First start of a new model downloads it: docker logs -f model-init

# ------------------------------------------------------------------------------
# STACK
# ------------------------------------------------------------------------------
# Which parts run. Add argus for the code index, tracing for Langfuse, logging for Loki.
COMPOSE_PROFILES=gateway,proxy,auth,smi,llamacpp
COMPOSE_PROJECT_NAME=llmservice
# Every service is https://<name>.<LLM_DOMAIN>. Change it here only; certificates and SSO follow.
LLM_DOMAIN=llm.localhost
# 127.0.0.1 = this machine only. 0.0.0.0 = the network.
BIND_ADDRESS=127.0.0.1
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443


# ------------------------------------------------------------------------------
# MODEL
# ------------------------------------------------------------------------------
# >>> MODEL -- the admin panel's Model card swaps exactly this block.
# The one name every client sees (gateway, Open WebUI, Qwen Code). Nothing else is listed.
MODEL_NAME=Qwen3.8-27B
# Context window in tokens, shared by all slots (see --kv-unified).
MODEL_CONTEXT=262144
# Largest completion the gateway advertises.
MODEL_MAX_OUTPUT=32768
# Host directory for the GGUF files. PUT IT ON NVMe: the weights are paged in on demand.
LLAMACPP_MODEL_DIR=/srv/llm-models/Qwen3.8-27B
# Hugging Face repo to download from on first start. Empty = the files must already be in LLAMACPP_MODEL_DIR.
LLAMACPP_HF_REPO=unsloth/Qwen3.8-27B-GGUF
# Space-separated paths inside that repo. They land flat in LLAMACPP_MODEL_DIR and are SHA-256 checked.
LLAMACPP_HF_FILES=Qwen3.8-27B-UD-Q4_K_XL.gguf
# File name of the model (for a split GGUF, the first shard).
LLAMACPP_MODEL_FILE=Qwen3.8-27B-UD-Q4_K_XL.gguf
# A llama.cpp release tarball to run instead of the stock server. Empty = stock image.
LLAMACPP_ENGINE_URL=
# Checksum of that tarball.
LLAMACPP_ENGINE_SHA256=
# Multi-token prediction: tokens drafted per step. 0 = off.
LLAMACPP_MTP_DRAFT_MAX=2
# Separate MTP draft head file in LLAMACPP_MODEL_DIR. Empty = the model's own MTP layer.
LLAMACPP_MTP_HEAD=
# Extra flags for the draft.
LLAMACPP_MTP_ARGS=
# Layers on the GPU. 99 = all.
LLAMACPP_N_GPU_LAYERS=99
# MoE only: layers whose experts stay in system RAM. Raise if loading hits CUDA out of memory. 0 for dense models.
LLAMACPP_N_CPU_MOE=0
# KV cache precision. q8_0 halves it against f16 for little quality cost.
LLAMACPP_KV_TYPE=q8_0
# People served at the same time. More queue.
LLAMACPP_PARALLEL=2
# Anything else for llama-server.
LLAMACPP_EXTRA_ARGS=--flash-attn on -b 2048 -ub 512 --cache-reuse 256 --kv-unified
# The gateway's backend (http://vllm:8000/v1 for vLLM).
ENGINE_API_BASE=http://llamacpp:8080/v1
# <<< MODEL


# ------------------------------------------------------------------------------
# HARDWARE -- this machine, not the model
# ------------------------------------------------------------------------------
# Physical core count. Hyperthreads measured slower, not faster.
LLAMACPP_THREADS=16
# CPU ceiling for the engine container; keep it equal to LLAMACPP_THREADS.
LLAMACPP_CPUS=16
OLLAMA_CPUS=2
POSTGRES_CPUS=3
# Engine RAM ceiling, e.g. 56g. 0 = no limit.
LLAMACPP_MEM_LIMIT=0
# GPU power cap in watts (nvidia-smi -pl). Empty = driver default.
GPU_POWER_LIMIT_W=
# CPU package power cap in watts (Intel RAPL). Many boards ship with no limit and cook the CPU; 125 is Intel's spec for a 13700K. Empty = firmware setting.
CPU_POWER_LIMIT_W=


# ------------------------------------------------------------------------------
# SECRETS -- every one must be set; docker compose names any that is missing
# ------------------------------------------------------------------------------
# Password for the 'admin' account. 12+ characters.
AUTHELIA_ADMIN_PASSWORD=
# openssl rand -hex 32
PROXY_AUTH_PASSWORD=
PROXY_AUTH_USER=admin
# The engine's own key. openssl rand -hex 32
LLAMACPP_API_KEY=
# Must start with sk-:  echo sk-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=
# Must start with sk-:  echo sk-$(openssl rand -hex 24). Never change it after first start.
LITELLM_SALT_KEY=
# openssl rand -hex 32
LLM_PG_PASSWORD=
# openssl rand -hex 32
WEBUI_SECRET_KEY=
# openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=
# openssl rand -hex 32
AUTHELIA_SESSION_SECRET=
# openssl rand -hex 32. Never change it after first start.
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# openssl rand -hex 32
AUTHELIA_JWT_SECRET=
# openssl rand -hex 32
AUTHELIA_OIDC_HMAC_SECRET=
# openssl rand -hex 32
GRAFANA_OIDC_CLIENT_SECRET=
# openssl rand -hex 32
OPENWEBUI_OIDC_CLIENT_SECRET=
# openssl rand -hex 32
API_OIDC_CLIENT_SECRET=
# Only with the argus profile. openssl rand -hex 32
ARGUS_ADMIN_TOKEN=


# ------------------------------------------------------------------------------
# PEOPLE, GATEWAY AND DASHBOARDS
# ------------------------------------------------------------------------------
# Default monthly credit per person, in USD.
LITELLM_DEFAULT_USER_BUDGET=50
LITELLM_BUDGET_DURATION=1mo
LITELLM_WORKERS=1
WEBUI_DEFAULT_ROLE=user
GRAFANA_ADMIN_USER=localadmin
PROTECTED_CHAIN=sso-chain@file
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=20GB
# Only for gated Hugging Face repos.
HF_TOKEN=


# ------------------------------------------------------------------------------
# ARGUS (profile: argus) -- code index for agents
# ------------------------------------------------------------------------------
ARGUS_VERSION=latest
ARGUS_GITLAB_URL=
# GitLab token that can read every repository to index.
ARGUS_GITLAB_TOKEN=
