    {
      "id": 19,
      "type": "timeseries",
      "title": "Token volume (per window)",
      "description": "Tokens actually processed, from the counters. Replaces llama.cpp's own predicted_tokens_seconds / prompt_tokens_seconds gauges, which read 0 whenever nothing is in flight -- a panel that is flat zero while the engine is healthy teaches you to stop looking at it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "refId": "A",
          "range": true,
          "expr": "increase(llamacpp:tokens_predicted_total[$__rate_interval])",
          "legendFormat": "generated"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "refId": "B",
          "range": true,
          "expr": "increase(llamacpp:prompt_tokens_total[$__rate_interval])",
          "legendFormat": "prompt (processed)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "refId": "C",
          "range": true,
          "expr": "increase(llamacpp:prompt_tokens_cached_total[$__rate_interval])",
          "legendFormat": "prompt (cache hit)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
