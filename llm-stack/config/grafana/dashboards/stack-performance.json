    {
      "id": 10,
      "type": "stat",
      "title": "Prefix cache hit",
      "description": "Share of prompt tokens served from the prefix cache instead of being re-processed. This is what --cache-reuse and llama.cpp's slot reuse buy you. NOTE: high hit rates make a throughput benchmark meaningless -- vary prompts when measuring. Idle windows fall back to the lifetime average: a bare rate-ratio is 0/0 when nothing has been served recently, which evaluates to NaN and draws as 'No data' rather than as 'quiet'.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(rate(llamacpp:prompt_tokens_cached_total[$__rate_interval]) / (rate(llamacpp:prompt_tokens_total[$__rate_interval]) + rate(llamacpp:prompt_tokens_cached_total[$__rate_interval])) * 100 >= 0) or (llamacpp:prompt_tokens_cached_total / (llamacpp:prompt_tokens_total + llamacpp:prompt_tokens_cached_total) * 100)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
