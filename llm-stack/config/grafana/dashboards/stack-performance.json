    {
      "id": 16,
      "type": "timeseries",
      "title": "Prefill vs generation (tok/s)",
      "description": "The two numbers that define this deployment. Generation is CPU-bound here (experts run on CPU); prefill is GPU-assisted and falls off with prompt length. Idle windows fall back to the lifetime average: a bare rate-ratio is 0/0 when nothing has been served recently, which evaluates to NaN and draws as 'No data' rather than as 'quiet'.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(rate(llamacpp:tokens_predicted_total[$__rate_interval]) / rate(llamacpp:tokens_predicted_seconds_total[$__rate_interval]) >= 0) or (llamacpp:tokens_predicted_total / llamacpp:tokens_predicted_seconds_total)",
          "legendFormat": "generation",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(rate(llamacpp:prompt_tokens_total[$__rate_interval]) / rate(llamacpp:prompt_seconds_total[$__rate_interval]) >= 0) or (llamacpp:prompt_tokens_total / llamacpp:prompt_seconds_total)",
          "legendFormat": "prefill",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
