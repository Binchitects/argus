    {
      "type": "table",
      "title": "By model",
      "datasource": {
        "type": "postgres",
        "uid": "litellm-db"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "litellm-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model AS \"Model\", count(*) AS \"Requests\", COALESCE(sum(prompt_tokens),0) AS \"Prompt tokens\", COALESCE(sum(completion_tokens),0) AS \"Completion tokens\", round(COALESCE(percentile_cont(0.5) WITHIN GROUP (ORDER BY request_duration_ms),0)::numeric,0) AS \"p50 ms\", round(COALESCE(sum(spend),0)::numeric,4) AS \"Spend\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Recent requests",
      "datasource": {
        "type": "postgres",
        "uid": "litellm-db"
      },
      "description": "The raw rows. If a number above looks wrong, it is wrong here first.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "litellm-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"startTime\" AS \"Time\", \"user\" AS \"User\", model AS \"Model\", prompt_tokens AS \"Prompt\", completion_tokens AS \"Completion\", request_duration_ms AS \"ms\", cache_hit AS \"Cached\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") ORDER BY \"startTime\" DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
