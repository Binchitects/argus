      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "litellm-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0*count(*) FILTER (WHERE cache_hit = 'True')/NULLIF(count(*),0),0) AS \"Cache\" FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
